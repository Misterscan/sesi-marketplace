{
  "metadata": {
    "name": "Word Counter",
    "version": "1.0.0",
    "description": "Adds a 'Count' button to the header to analyze your script.",
    "icon": "data:image/svg+xml;utf8,%3Csvg%20width%3D%22100%22%20height%3D%22100%22%20viewBox%3D%220%200%20100%20100%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%0A%20%20%3Crect%20width%3D%22100%22%20height%3D%22100%22%20rx%3D%2224%22%20fill%3D%22%234F46E5%22%2F%3E%0A%20%20%3Crect%20x%3D%2220%22%20y%3D%2226%22%20width%3D%2260%22%20height%3D%228%22%20rx%3D%224%22%20fill%3D%22white%22%2F%3E%0A%20%20%3Crect%20x%3D%2220%22%20y%3D%2242%22%20width%3D%2240%22%20height%3D%228%22%20rx%3D%224%22%20fill%3D%22white%22%2F%3E%0A%20%20%3Crect%20x%3D%2220%22%20y%3D%2258%22%20width%3D%2255%22%20height%3D%228%22%20rx%3D%224%22%20fill%3D%22white%22%2F%3E%0A%20%20%3Crect%20x%3D%2220%22%20y%3D%2274%22%20width%3D%2230%22%20height%3D%228%22%20rx%3D%224%22%20fill%3D%22white%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2275%22%20cy%3D%2270%22%20r%3D%2212%22%20fill%3D%22%2310B981%22%2F%3E%3C%2Fsvg%3E",
    "commands": [
      "Count Words"
    ],
    "license": "MIT"
  },
  "js": "\n\n\n(function() {\n  function initWordCounter() {\n    // Wait for the UI controls to be available in the header\n    const controls = document.querySelector('.controls');\n    if (!controls) {\n      setTimeout(initWordCounter, 500);\n      return;\n    }\n\n    // Create the button\n    const countBtn = document.createElement('button');\n    countBtn.className = 'btn';\n    countBtn.style.marginLeft = '8px';\n    countBtn.innerHTML = '📊 Count';\n    \n    const countWords = () => {\n      if (!window.editor) return;\n      \n      const text = window.editor.getValue();\n      const words = text.trim() ? text.trim().split(/\\s+/).length : 0;\n      const chars = text.length;\n      \n      // You can output to an alert, or even write directly to the integrated terminal\n      if (window.terminal) {\n        window.terminal.write(`\\r\\n\\x1b[36m[Word Counter]\\x1b[0m ${words} words, ${chars} characters.\\r\\n`);\n      } else {\n        alert(`Words: ${words}\\nCharacters: ${chars}`);\n      }\n    };\n\n    countBtn.onclick = countWords;\n    controls.appendChild(countBtn);\n\n    // Register with built-in Command Palette\n    if (window.registerCommand) {\n      window.registerCommand(\"Count Words\", countWords);\n    }\n    \n    console.log(\"✓ Word Counter extension loaded!\");\n  }\n\n  initWordCounter();\n})();"
}