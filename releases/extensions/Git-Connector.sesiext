{
  "metadata": {
    "name": "Git Connector",
    "version": "1.0.0",
    "description": "Integrated Git repository control and file diffing for Sesi Studio.",
    "icon": "data:image/svg+xml;utf8,%3Csvg%20viewBox%3D%220%200%20100%20100%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%0A%20%20%3Crect%20width%3D%22100%22%20height%3D%22100%22%20rx%3D%2222%22%20fill%3D%22%230f1012%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M42%2020V80%22%20stroke%3D%22%238b5cf6%22%20stroke-width%3D%2210%22%20stroke-linecap%3D%22round%22%20fill%3D%22none%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M42%2045C72%2045%2072%2065%2072%2065%22%20stroke%3D%22%23f59e0b%22%20stroke-width%3D%2210%22%20stroke-linecap%3D%22round%22%20fill%3D%22none%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2242%22%20cy%3D%2225%22%20r%3D%228%22%20fill%3D%22%238b5cf6%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2242%22%20cy%3D%2275%22%20r%3D%228%22%20fill%3D%22%2310b981%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2272%22%20cy%3D%2265%22%20r%3D%228%22%20fill%3D%22%23f59e0b%22%2F%3E%0A%3C%2Fsvg%3E",
    "commands": [
      "Git: View Status",
      "Git: Pull",
      "Git: Push",
      "Git: Commit Staged",
      "Git: Initialize Repository",
      "Git: Show Commit History"
    ],
    "license": "MIT"
  },
  "js": "\n\n(function() {\n  function initGitExtension() {\n    const sidebarHistory = document.getElementById('sidebarHistory');\n    if (!sidebarHistory) {\n      // Retry if UI is not fully loaded\n      setTimeout(initGitExtension, 500);\n      return;\n    }\n\n    const historyParent = sidebarHistory.parentElement;\n    const panelHeader = historyParent.querySelector('.panel-header');\n    if (!panelHeader) return;\n\n    // 1. Redesign header to support tabs (Timeline vs Git)\n    panelHeader.style.display = 'flex';\n    panelHeader.style.justifyContent = 'space-between';\n    panelHeader.style.alignItems = 'center';\n    panelHeader.style.padding = '0 12px';\n\n    panelHeader.innerHTML = `\n      <div style=\"display: flex; gap: 16px; align-items: center; height: 100%;\">\n        <span id=\"git-tab-timeline\" class=\"panel-title\" style=\"color: #fff; cursor: pointer; border-bottom: 2px solid var(--accent-cyan); padding-bottom: 4px;\">Timeline</span>\n        <span id=\"git-tab-git\" class=\"panel-title\" style=\"color: var(--silver-dark); cursor: pointer; padding-bottom: 4px;\">Git</span>\n      </div>\n      <button id=\"git-refresh-btn\" style=\"background:none; border:none; color:var(--accent-cyan); cursor:pointer; font-size:11px; display:none; font-family:inherit;\">Refresh</button>\n    `;\n\n    // 2. Create the Git container inside sidebar bottom panel\n    let sidebarGit = document.getElementById('sidebarGit');\n    if (!sidebarGit) {\n      sidebarGit = document.createElement('div');\n      sidebarGit.id = 'sidebarGit';\n      sidebarGit.style.cssText = 'flex: 1; overflow-y: auto; padding: 12px; display: none; font-size: 11px; font-family: monospace; color: var(--silver-mid);';\n      historyParent.appendChild(sidebarGit);\n    }\n\n    const timelineTab = document.getElementById('git-tab-timeline');\n    const gitTab = document.getElementById('git-tab-git');\n    const refreshBtn = document.getElementById('git-refresh-btn');\n\n    // Tab Switch Logic\n    timelineTab.onclick = () => {\n      timelineTab.style.color = '#fff';\n      timelineTab.style.borderBottom = '2px solid var(--accent-cyan)';\n      gitTab.style.color = 'var(--silver-dark)';\n      gitTab.style.borderBottom = 'none';\n      \n      sidebarHistory.style.display = 'block';\n      sidebarGit.style.display = 'none';\n      refreshBtn.style.display = 'none';\n    };\n\n    gitTab.onclick = () => {\n      gitTab.style.color = '#fff';\n      gitTab.style.borderBottom = '2px solid var(--accent-cyan)';\n      timelineTab.style.color = 'var(--silver-dark)';\n      timelineTab.style.borderBottom = 'none';\n      \n      sidebarHistory.style.display = 'none';\n      sidebarGit.style.display = 'block';\n      refreshBtn.style.display = 'inline-block';\n      \n      refreshGitStatus();\n    };\n\n    refreshBtn.onclick = () => {\n      refreshGitStatus();\n    };\n\n    // 3. Hook into Sesi Studio file saves to refresh Git panel automatically\n    const originalSave = window.saveActiveFile;\n    if (originalSave) {\n      window.saveActiveFile = async function() {\n        await originalSave.apply(this, arguments);\n        if (sidebarGit.style.display !== 'none') {\n          setTimeout(refreshGitStatus, 500); // Give filesystem a moment to sync\n        }\n      };\n    }\n\n    // --- Core Git Operations ---\n\n    async function refreshGitStatus() {\n      sidebarGit.innerHTML = '<div style=\"padding: 12px; color: var(--silver-dark);\">Checking git status...</div>';\n      try {\n        const res = await fetch('/api/git', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ action: 'status' })\n        });\n        const data = await res.json();\n        if (!data.initialized) {\n          renderUninitialized();\n          return;\n        }\n        renderGitStatus(data.branch, data.status);\n      } catch (err) {\n        sidebarGit.innerHTML = `<div style=\"color: #ff5f56; padding: 12px;\">Error: ${err.message}</div>`;\n      }\n    }\n\n    function renderUninitialized() {\n      sidebarGit.innerHTML = `\n        <div style=\"padding: 24px 12px; text-align: center; display: flex; flex-direction: column; gap: 12px; align-items: center;\">\n          <span style=\"color: var(--silver-dark); font-size: 11px;\">No Git repository detected in this workspace.</span>\n          <button id=\"git-init-btn\" class=\"btn\" style=\"padding: 6px 12px; font-size: 11px; cursor: pointer; background: rgba(0, 229, 255, 0.05); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); font-weight: bold; border-radius: 4px;\">Initialize Repository</button>\n        </div>\n      `;\n      \n      document.getElementById('git-init-btn').onclick = async () => {\n        sidebarGit.innerHTML = '<div style=\"padding: 12px; color: var(--silver-dark);\">Initializing repository...</div>';\n        try {\n          const res = await fetch('/api/git', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ action: 'init' })\n          });\n          const data = await res.json();\n          if (data.success) {\n            if (window.terminal) {\n              window.terminal.write('\\r\\n\\x1b[32m[Git] Initialized empty Git repository.\\x1b[0m\\r\\n');\n            }\n            refreshGitStatus();\n          } else {\n            alert('Failed to initialize: ' + data.error);\n            refreshGitStatus();\n          }\n        } catch (err) {\n          alert('Error: ' + err.message);\n          refreshGitStatus();\n        }\n      };\n    }\n\n    function renderGitStatus(branch, statusText) {\n      const lines = statusText.split('\\n');\n      const staged = [];\n      const unstaged = [];\n      const untracked = [];\n\n      lines.forEach(line => {\n        if (!line.trim()) return;\n        const indexStatus = line[0];\n        const workStatus = line[1];\n        const filePath = line.substring(3).trim();\n\n        let displayPath = filePath;\n        let actualPath = filePath;\n        if (filePath.includes(' -> ')) {\n          const parts = filePath.split(' -> ');\n          displayPath = parts.join(' ➔ ');\n          actualPath = parts[1];\n        }\n\n        // Untracked\n        if (indexStatus === '?' && workStatus === '?') {\n          untracked.push({ path: actualPath, display: displayPath, type: 'untracked', statusChar: '?' });\n        } else {\n          // Staged\n          if (indexStatus !== ' ' && indexStatus !== '?') {\n            let typeLabel = 'modified';\n            if (indexStatus === 'A') typeLabel = 'added';\n            if (indexStatus === 'D') typeLabel = 'deleted';\n            if (indexStatus === 'R') typeLabel = 'renamed';\n            staged.push({ path: actualPath, display: displayPath, type: typeLabel, statusChar: indexStatus });\n          }\n          // Unstaged\n          if (workStatus !== ' ' && workStatus !== '?') {\n            let typeLabel = 'modified';\n            if (workStatus === 'D') typeLabel = 'deleted';\n            unstaged.push({ path: actualPath, display: displayPath, type: typeLabel, statusChar: workStatus });\n          }\n        }\n      });\n\n      let html = `\n        <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 1px solid rgba(255, 255, 255, 0.05);\">\n          <div style=\"color: var(--accent-cyan); font-weight: bold; font-size: 11px; display: flex; align-items: center; gap: 4px;\">\n            <span>🌿</span> <span>${branch || 'detached'}</span>\n          </div>\n          <div style=\"display: flex; gap: 6px;\">\n            <button id=\"git-btn-pull\" class=\"git-small-btn\" title=\"Git Pull\" style=\"background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: var(--silver-light); font-size: 10px; cursor: pointer; padding: 2px 5px; border-radius: 3px; font-family: inherit;\">⬇️ Pull</button>\n            <button id=\"git-btn-push\" class=\"git-small-btn\" title=\"Git Push\" style=\"background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: var(--silver-light); font-size: 10px; cursor: pointer; padding: 2px 5px; border-radius: 3px; font-family: inherit;\">⬆️ Push</button>\n          </div>\n        </div>\n        \n        <div style=\"display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px;\">\n          <div style=\"display: flex; gap: 4px; width: 100%; align-items: flex-start;\">\n            <textarea id=\"git-commit-msg\" placeholder=\"Commit message...\" style=\"background: #000; border: 1px solid var(--glass-border); border-radius: 4px; padding: 6px; color: #fff; font-size: 10px; outline: none; flex: 1; min-height: 48px; resize: vertical; box-sizing: border-box; font-family: inherit;\"></textarea>\n            <button id=\"git-generate-msg-btn\" title=\"Generate commit message using Sesi\" style=\"background: rgba(0, 229, 255, 0.1); border: 1px solid var(--glass-border); color: var(--accent-cyan); border-radius: 4px; padding: 6px 8px; font-size: 10px; cursor: pointer; font-family: inherit; display: flex; align-items: center; justify-content: center; min-width: 30px; height: 30px;\">✨</button>\n          </div>\n          <button id=\"git-commit-btn\" class=\"btn\" style=\"padding: 6px; font-size: 10px; font-weight: bold; background: rgba(0, 229, 255, 0.1); border-color: var(--accent-cyan); color: var(--accent-cyan); border-radius: 4px; cursor: pointer; width: 100%; font-family: inherit;\">✓ Commit Staged</button>\n        </div>\n      `;\n\n      // Render Staged Changes\n      if (staged.length > 0) {\n        html += `\n          <div style=\"font-weight: bold; margin-top: 8px; margin-bottom: 6px; text-transform: uppercase; font-size: 9px; color: var(--accent-cyan); letter-spacing: 0.5px;\">Staged Changes (${staged.length})</div>\n          <div style=\"display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px;\">\n        `;\n        staged.forEach(f => {\n          let badgeColor = '#f59e0b';\n          if (f.statusChar === 'A') badgeColor = '#10b981';\n          if (f.statusChar === 'D') badgeColor = '#ef4444';\n          \n          html += `\n            <div class=\"git-file-row\" style=\"display: flex; justify-content: space-between; align-items: center; padding: 4px 6px; border-radius: 4px; background: rgba(255,255,255,0.02);\">\n              <div style=\"display: flex; align-items: center; gap: 6px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 70%;\" title=\"${f.path}\">\n                <span style=\"font-weight: bold; color: ${badgeColor}; font-size: 9px; width: 12px; text-align: center;\">${f.statusChar}</span>\n                <span style=\"color: var(--silver-light); font-size: 10px; overflow: hidden; text-overflow: ellipsis;\">${f.display}</span>\n              </div>\n              <div style=\"display: flex; gap: 4px;\">\n                <button class=\"git-icon-btn git-btn-diff\" data-path=\"${f.path}\" title=\"Diff changes\" style=\"background: none; border: none; color: var(--accent-cyan); cursor: pointer; padding: 2px; font-size: 10px;\">🔍</button>\n                <button class=\"git-icon-btn git-btn-unstage\" data-path=\"${f.path}\" title=\"Unstage file\" style=\"background: none; border: none; color: #ff5f56; cursor: pointer; padding: 2px; font-size: 10px;\">-</button>\n              </div>\n            </div>\n          `;\n        });\n        html += `</div>`;\n      }\n\n      // Render Changes (Unstaged & Untracked)\n      const unstagedCount = unstaged.length + untracked.length;\n      if (unstagedCount > 0) {\n        html += `\n          <div style=\"font-weight: bold; margin-top: 8px; margin-bottom: 6px; text-transform: uppercase; font-size: 9px; color: var(--accent-cyan); letter-spacing: 0.5px;\">Changes (${unstagedCount})</div>\n          <div style=\"display: flex; flex-direction: column; gap: 4px;\">\n        `;\n        unstaged.forEach(f => {\n          let badgeColor = '#f59e0b';\n          if (f.statusChar === 'D') badgeColor = '#ef4444';\n          \n          html += `\n            <div class=\"git-file-row\" style=\"display: flex; justify-content: space-between; align-items: center; padding: 4px 6px; border-radius: 4px; background: rgba(255,255,255,0.02);\">\n              <div style=\"display: flex; align-items: center; gap: 6px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 70%;\" title=\"${f.path}\">\n                <span style=\"font-weight: bold; color: ${badgeColor}; font-size: 9px; width: 12px; text-align: center;\">M</span>\n                <span style=\"color: var(--silver-light); font-size: 10px; overflow: hidden; text-overflow: ellipsis;\">${f.display}</span>\n              </div>\n              <div style=\"display: flex; gap: 4px;\">\n                <button class=\"git-icon-btn git-btn-diff\" data-path=\"${f.path}\" title=\"Diff changes\" style=\"background: none; border: none; color: var(--accent-cyan); cursor: pointer; padding: 2px; font-size: 10px;\">🔍</button>\n                <button class=\"git-icon-btn git-btn-discard\" data-path=\"${f.path}\" title=\"Discard changes\" style=\"background: none; border: none; color: #ff5f56; cursor: pointer; padding: 2px; font-size: 10px;\">⟲</button>\n                <button class=\"git-icon-btn git-btn-stage\" data-path=\"${f.path}\" title=\"Stage file\" style=\"background: none; border: none; color: #10b981; cursor: pointer; padding: 2px; font-size: 10px;\">+</button>\n              </div>\n            </div>\n          `;\n        });\n        untracked.forEach(f => {\n          html += `\n            <div class=\"git-file-row\" style=\"display: flex; justify-content: space-between; align-items: center; padding: 4px 6px; border-radius: 4px; background: rgba(255,255,255,0.02);\">\n              <div style=\"display: flex; align-items: center; gap: 6px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 70%;\" title=\"${f.path}\">\n                <span style=\"font-weight: bold; color: #10b981; font-size: 9px; width: 12px; text-align: center;\">U</span>\n                <span style=\"color: var(--silver-light); font-size: 10px; overflow: hidden; text-overflow: ellipsis;\">${f.display}</span>\n              </div>\n              <div style=\"display: flex; gap: 4px;\">\n                <button class=\"git-icon-btn git-btn-diff\" data-path=\"${f.path}\" title=\"Diff changes\" style=\"background: none; border: none; color: var(--accent-cyan); cursor: pointer; padding: 2px; font-size: 10px;\">🔍</button>\n                <button class=\"git-icon-btn git-btn-stage\" data-path=\"${f.path}\" title=\"Stage file\" style=\"background: none; border: none; color: #10b981; cursor: pointer; padding: 2px; font-size: 10px;\">+</button>\n              </div>\n            </div>\n          `;\n        });\n        html += `</div>`;\n      }\n\n      if (staged.length === 0 && unstagedCount === 0) {\n        html += `<div style=\"padding: 16px 8px; color: var(--silver-dark); text-align: center;\">No changes detected. Workspace clean!</div>`;\n      }\n\n      sidebarGit.innerHTML = html;\n\n      // Click Events\n      document.getElementById('git-btn-pull').onclick = () => runGitAction('pull');\n      document.getElementById('git-btn-push').onclick = () => runGitAction('push');\n      \n      const commitBtn = document.getElementById('git-commit-btn');\n      commitBtn.onclick = () => {\n        const msgInput = document.getElementById('git-commit-msg');\n        const msg = msgInput.value.trim();\n        if (!msg) {\n          alert('Please enter a commit message.');\n          return;\n        }\n        runGitAction('commit', { message: msg });\n      };\n\n      const generateBtn = document.getElementById('git-generate-msg-btn');\n      if (generateBtn) {\n        generateBtn.onclick = () => {\n          if (staged.length === 0) {\n            alert('No staged changes detected. Please stage files first.');\n            return;\n          }\n          \n          generateBtn.disabled = true;\n          generateBtn.innerText = '⏳';\n          const msgInput = document.getElementById('git-commit-msg');\n          msgInput.placeholder = 'Generating commit message...';\n          \n          fetch('/api/git', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ action: 'generate_commit_msg' })\n          })\n          .then(res => res.json())\n          .then(data => {\n            generateBtn.disabled = false;\n            generateBtn.innerText = '✨';\n            if (data.success && data.message) {\n              msgInput.value = data.message;\n              msgInput.placeholder = 'Commit message...';\n            } else {\n              alert(data.error || 'Failed to generate commit message.');\n              msgInput.placeholder = 'Commit message...';\n            }\n          })\n          .catch(err => {\n            generateBtn.disabled = false;\n            generateBtn.innerText = '✨';\n            alert('Error generating message: ' + err.message);\n            msgInput.placeholder = 'Commit message...';\n          });\n        };\n      }\n\n      sidebarGit.querySelectorAll('.git-btn-stage').forEach(btn => {\n        btn.onclick = () => runGitAction('add', { file: btn.getAttribute('data-path') });\n      });\n      \n      sidebarGit.querySelectorAll('.git-btn-unstage').forEach(btn => {\n        btn.onclick = () => runGitAction('unstage', { file: btn.getAttribute('data-path') });\n      });\n\n      sidebarGit.querySelectorAll('.git-btn-discard').forEach(btn => {\n        btn.onclick = () => {\n          if (confirm(`Are you sure you want to discard changes in ${btn.getAttribute('data-path')}?`)) {\n            runGitAction('discard', { file: btn.getAttribute('data-path') });\n          }\n        };\n      });\n\n      sidebarGit.querySelectorAll('.git-btn-diff').forEach(btn => {\n        btn.onclick = () => openDiffModal(btn.getAttribute('data-path'));\n      });\n    }\n\n    async function runGitAction(action, payload = {}) {\n      if (window.terminal) {\n        window.terminal.write(`\\r\\n\\x1b[36m[Git] Running action: ${action}...\\x1b[0m\\r\\n`);\n      }\n      \n      try {\n        const res = await fetch('/api/git', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ action, ...payload })\n        });\n        const data = await res.json();\n        if (data.success || data.initialized || data.output !== undefined) {\n          if (window.terminal && data.output) {\n            window.terminal.write(`${data.output.replace(/\\n/g, '\\r\\n')}\\r\\n`);\n          }\n          refreshGitStatus();\n        } else {\n          if (window.terminal && data.error) {\n            window.terminal.write(`\\x1b[31m[Git Error] ${data.error}\\x1b[0m\\r\\n`);\n          }\n          alert('Git Error: ' + (data.error || 'Action failed'));\n          refreshGitStatus();\n        }\n      } catch (err) {\n        if (window.terminal) {\n          window.terminal.write(`\\x1b[31m[Git Network Error] ${err.message}\\x1b[0m\\r\\n`);\n        }\n        alert('Git Network Error: ' + err.message);\n        refreshGitStatus();\n      }\n    }\n\n    function openDiffModal(filePath) {\n      let modal = document.getElementById('git-diff-modal');\n      if (!modal) {\n        modal = document.createElement('div');\n        modal.id = 'git-diff-modal';\n        modal.style.cssText = `\n          position: fixed;\n          top: 0; left: 0;\n          width: 100vw; height: 100vh;\n          background: rgba(0,0,0,0.85);\n          backdrop-filter: blur(12px);\n          display: flex;\n          justify-content: center;\n          align-items: center;\n          z-index: 5000;\n          font-family: inherit;\n        `;\n        modal.innerHTML = `\n          <div style=\"background: var(--bg-panel); border: 1px solid var(--glass-border); width: 85vw; height: 85vh; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.6);\">\n            <div style=\"padding: 16px 24px; border-bottom: 1px solid var(--glass-border); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.2);\">\n              <h2 style=\"font-size: 13px; color: var(--accent-cyan); margin: 0; font-family: monospace; font-weight: bold; text-transform: uppercase;\" id=\"git-diff-title\">Diff View</h2>\n              <button class=\"btn\" id=\"git-diff-close-btn\" style=\"padding: 4px 12px; font-size: 11px; font-family: inherit; font-weight: bold; cursor: pointer;\">Close</button>\n            </div>\n            <div id=\"git-diff-editor-container\" style=\"flex: 1; width: 100%; height: 100%;\"></div>\n          </div>\n        `;\n        document.body.appendChild(modal);\n        \n        document.getElementById('git-diff-close-btn').onclick = () => {\n          modal.style.display = 'none';\n          if (window.gitDiffEditor) {\n            window.gitDiffEditor.dispose();\n            window.gitDiffEditor = null;\n          }\n        };\n      }\n      \n      modal.style.display = 'flex';\n      document.getElementById('git-diff-title').innerText = `Diff: ${filePath}`;\n      \n      fetch('/api/git', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ action: 'diff', file: filePath })\n      })\n      .then(res => res.json())\n      .then(data => {\n        const container = document.getElementById('git-diff-editor-container');\n        container.innerHTML = '';\n        \n        window.gitDiffEditor = monaco.editor.createDiffEditor(container, {\n          theme: 'sesi-theme',\n          automaticLayout: true,\n          readOnly: true,\n          minimap: { enabled: false }\n        });\n        \n        const ext = filePath.split('.').pop();\n        let lang = 'plaintext';\n        if (ext === 'sesi') lang = 'sesi';\n        else if (ext === 'js' || ext === 'mjs') lang = 'javascript';\n        else if (ext === 'ts' || ext === 'tsx') lang = 'typescript';\n        else if (ext === 'chtml') lang = 'chtml';\n        else if (ext === 'css') lang = 'css';\n        else if (ext === 'json') lang = 'json';\n        else if (ext === 'md') lang = 'markdown';\n        \n        window.gitDiffEditor.setModel({\n          original: monaco.editor.createModel(data.original || '', lang),\n          modified: monaco.editor.createModel(data.modified || '', lang)\n        });\n      })\n      .catch(err => {\n        console.error('Failed to load diff:', err);\n        alert('Failed to load diff: ' + err.message);\n      });\n    }\n\n    // Register Sesi Command Palette Integration\n    if (window.registerCommand) {\n      window.registerCommand(\"Git: View Status\", () => {\n        const gitTab = document.getElementById('git-tab-git');\n        if (gitTab) gitTab.click();\n      });\n      window.registerCommand(\"Git: Pull\", () => {\n        runGitAction('pull');\n      });\n      window.registerCommand(\"Git: Push\", () => {\n        runGitAction('push');\n      });\n      window.registerCommand(\"Git: Initialize Repository\", () => {\n        runGitAction('init');\n      });\n      window.registerCommand(\"Git: Show Commit History\", async () => {\n        try {\n          const res = await fetch('/api/git', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ action: 'log' })\n          });\n          const data = await res.json();\n          if (data.success && window.terminal) {\n            window.terminal.write(`\\r\\n\\x1b[36m[Git History]\\x1b[0m\\r\\n${data.log.replace(/\\n/g, '\\r\\n')}\\r\\n`);\n          }\n        } catch (err) {\n          alert(\"Error loading git history: \" + err.message);\n        }\n      });\n    }\n\n    console.log(\"✓ Git Connector extension loaded!\");\n  }\n\n  initGitExtension();\n})();\n"
}