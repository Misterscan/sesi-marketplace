{
  "metadata": {
    "name": "Twitr",
    "version": "1.0.0",
    "description": "Mimics the classic social media aesthetic with a high-contrast dark mode and signature blue accents. Clean, recognizable, and perfect for text-heavy content.",
    "author": "Community",
    "icon": "🐦",
    "commands": [
      "Apply Twitr"
    ]
  },
  "css": "\n\n:root {\n  --bg-base: #000000;\n  --bg-panel: #15202b;\n  --accent-cyan: #1d9bf0;\n  --accent-blue: #1d9bf0;\n  --accent-green: #00ba7c;\n  --silver-light: #e7e9ea;\n  --silver-mid: #71767b;\n  --silver-dark: #2f3336;\n  --glass-bg: rgba(0, 0, 0, 0.8);\n  --glass-border: #2f3336;\n  --glass-highlight: rgba(29, 155, 240, 0.1);\n}\n\nbody {\n  background-color: var(--bg-base);\n  color: var(--silver-light);\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n}\n\nheader {\n  background: rgba(0, 0, 0, 0.85);\n  border-bottom: 1px solid var(--glass-border);\n}\n\n.brand h1 {\n  color: var(--accent-cyan);\n  font-weight: 800;\n}\n\n.glow-text {\n  color: var(--silver-light);\n  text-shadow: none;\n}\n\n.btn {\n  background: var(--accent-cyan);\n  border: none;\n  color: #ffffff;\n  border-radius: 9999px;\n  font-weight: 700;\n  padding: 8px 16px;\n  transition: background 0.2s ease;\n}\n\n.btn:hover {\n  background: #1a8cd8;\n  border-color: transparent;\n}\n\n#settingsBtn {\n  background: transparent;\n  border: 1px solid var(--silver-mid);\n  color: var(--silver-light);\n}\n\n#settingsBtn:hover {\n  background: rgba(231, 233, 234, 0.1);\n}\n\n.panel {\n  background: var(--bg-base);\n  border-right: 1px solid var(--glass-border);\n}\n\n.panel-header {\n  background: transparent;\n  border-bottom: 1px solid var(--glass-border);\n  height: 48px;\n}\n\n.panel-title {\n  color: var(--silver-light);\n  font-size: 13px;\n  text-transform: none;\n  letter-spacing: normal;\n}\n\n.file-item {\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--glass-border);\n  color: var(--silver-light);\n}\n\n.file-item:hover {\n  background: rgba(255, 255, 255, 0.03);\n}\n\n.file-item.active {\n  background: rgba(29, 155, 240, 0.1);\n  border-left: none;\n  color: var(--accent-cyan);\n}\n\n.tab-bar {\n  background: var(--bg-base);\n  border-bottom: 1px solid var(--glass-border);\n}\n\n.tab {\n  border-right: none;\n  position: relative;\n  font-weight: 500;\n  color: var(--silver-mid);\n}\n\n.tab.active {\n  background: transparent;\n  color: var(--silver-light);\n  border-bottom: none;\n}\n\n.tab.active::after {\n  content: \"\";\n  position: absolute;\n  bottom: 0;\n  left: 20%;\n  right: 20%;\n  height: 4px;\n  background: var(--accent-cyan);\n  border-radius: 9999px;\n}\n\n.editor-container-wrapper {\n  background: var(--bg-base);\n}\n\n.terminal-container-wrapper {\n  background: var(--bg-base);\n  border-top: 1px solid var(--glass-border);\n}\n\n.chat-messages {\n  background: var(--bg-base);\n}\n\n.message {\n  max-width: 85%;\n  border-radius: 16px;\n  font-size: 14px;\n  padding: 12px 16px;\n}\n\n.message.system {\n  background: #2f3336;\n  border: none;\n  color: var(--silver-light);\n  border-bottom-left-radius: 2px;\n}\n\n.message.user {\n  background: var(--accent-cyan);\n  border: none;\n  color: #ffffff;\n  border-bottom-right-radius: 2px;\n}\n\n.chat-input-area {\n  background: var(--bg-base);\n  border-top: 1px solid var(--glass-border);\n  padding: 16px;\n}\n\n.chat-input {\n  background: #202327;\n  border: 1px solid transparent;\n  border-radius: 9999px;\n  padding: 10px 20px;\n  color: var(--silver-light);\n}\n\n.chat-input:focus {\n  background: var(--bg-base);\n  border-color: var(--accent-cyan);\n  box-shadow: none;\n}\n\n.chat-tab {\n  border-right: 1px solid var(--glass-border);\n  background: transparent;\n}\n\n.chat-tab.active {\n  background: rgba(29, 155, 240, 0.1);\n  color: var(--accent-cyan);\n}\n\n.settings-tab.active {\n  background: transparent;\n  color: var(--accent-cyan) !important;\n  border-left: none;\n  font-weight: 800;\n}\n\n.code-action-btn {\n  border-radius: 9999px;\n  padding: 4px 12px;\n  background: transparent;\n  border: 1px solid var(--accent-cyan);\n}\n\n.message pre {\n  background: #16181c;\n  border: 1px solid var(--glass-border);\n  border-radius: 12px;\n}\n\n/* Scrollbar Styling */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--bg-base);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--silver-dark);\n  border-radius: 10px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--silver-mid);\n}\n\n/* Monaco Customization Overrides */\n.monaco-editor, .monaco-editor .margin {\n  background-color: var(--bg-base) !important;\n}\n\n.monaco-editor .line-numbers {\n  color: var(--silver-dark) !important;\n}\n\n.monaco-editor .current-line {\n  background-color: rgba(255, 255, 255, 0.03) !important;\n  border: none !important;\n}"
}