{
  "metadata": {
    "name": "StormCenter 95",
    "version": "1.0.0",
    "description": "A nostalgic broadcast-inspired aesthetic modeled after 90s cable news weather graphics, featuring blue gradients and low-fidelity digital overlays.",
    "author": "Misterscan",
    "icon": "⛈️",
    "commands": [
      "Apply StormCenter 95"
    ]
  },
  "css": "\n\n:root {\n  --bg-base: #003399;\n  --bg-panel: #0044bb;\n  --accent-cyan: #ffff00; /* Bright yellow for that classic weather alert look */\n  --accent-blue: #00f2ff;\n  --accent-green: #00ff00;\n  --silver-light: #ffffff;\n  --silver-mid: #99ccff;\n  --silver-dark: #002266;\n  --glass-bg: rgba(0, 40, 150, 0.9);\n  --glass-border: #ffffff;\n  --glass-highlight: rgba(255, 255, 255, 0.4);\n  --news-gradient: linear-gradient(180deg, #003399 0%, #0066ff 50%, #003399 100%);\n  --ticker-bg: #cc0000;\n}\n\nbody {\n  background: var(--bg-base);\n  background-image: \n    linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%),\n    linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));\n  background-size: 100% 4px, 3px 100%;\n  text-shadow: 1px 1px 2px rgba(0,0,0,0.8);\n}\n\n/* CRT Scanline Overlay */\nbody::before {\n  content: \" \";\n  display: block;\n  position: absolute;\n  top: 0;\n  left: 0;\n  bottom: 0;\n  right: 0;\n  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02));\n  z-index: 9999;\n  background-size: 100% 2px, 3px 100%;\n  pointer-events: none;\n}\n\nheader {\n  background: var(--news-gradient) !important;\n  border-bottom: 3px solid var(--accent-cyan) !important;\n  box-shadow: 0 4px 10px rgba(0,0,0,0.5);\n  height: 60px !important;\n}\n\n.brand h1 {\n  font-family: 'Arial Black', sans-serif;\n  text-transform: uppercase;\n  font-style: italic;\n  letter-spacing: 1px;\n  color: #fff;\n  filter: drop-shadow(2px 2px 0px #000);\n}\n\n.brand h1::before {\n  content: \"LIVE\";\n  background: var(--ticker-bg);\n  color: white;\n  padding: 2px 6px;\n  font-size: 10px;\n  margin-right: 8px;\n  border-radius: 0;\n  vertical-align: middle;\n  animation: blink 1s steps(2) infinite;\n}\n\n@keyframes blink {\n  0% { opacity: 1; }\n  100% { opacity: 0; }\n}\n\n.btn {\n  background: #dddddd !important;\n  border: 2px solid #ffffff !important;\n  border-right-color: #444 !important;\n  border-bottom-color: #444 !important;\n  color: #000 !important;\n  border-radius: 0 !important;\n  font-weight: 900 !important;\n  text-transform: uppercase;\n  box-shadow: 2px 2px 0px rgba(0,0,0,0.5);\n}\n\n.btn:hover {\n  background: var(--accent-cyan) !important;\n}\n\n.panel {\n  background: var(--bg-panel) !important;\n  border: 2px solid var(--silver-dark) !important;\n}\n\n.panel-header {\n  background: var(--news-gradient) !important;\n  border-bottom: 2px solid var(--silver-light) !important;\n}\n\n.panel-title {\n  color: var(--accent-cyan) !important;\n  font-family: 'Arial Black', sans-serif;\n  text-shadow: 2px 2px #000;\n}\n\n.tab-bar {\n  background: #002266 !important;\n  padding-top: 4px;\n}\n\n.tab {\n  background: #0044bb !important;\n  border: 2px solid #ffffff !important;\n  border-bottom: none !important;\n  margin-right: 4px;\n  color: #fff !important;\n  font-weight: bold;\n  border-radius: 8px 8px 0 0 !important;\n}\n\n.tab.active {\n  background: var(--accent-cyan) !important;\n  color: #000 !important;\n  border-bottom: none !important;\n}\n\n.file-item {\n  color: #fff !important;\n  border-bottom: 1px solid rgba(255,255,255,0.1);\n}\n\n.file-item:hover {\n  background: rgba(255,255,255,0.2) !important;\n}\n\n.file-item.active {\n  background: var(--accent-cyan) !important;\n  color: #000 !important;\n  border: none !important;\n}\n\n.terminal-container-wrapper {\n  border-top: 4px solid var(--accent-cyan) !important;\n  background: #000 !important;\n}\n\n.chat-input {\n  background: #fff !important;\n  color: #000 !important;\n  border: 3px solid #000 !important;\n  border-radius: 0 !important;\n}\n\n.message.system {\n  background: #003399 !important;\n  border: 2px solid var(--accent-cyan) !important;\n  color: #fff !important;\n  border-radius: 0 !important;\n  box-shadow: 4px 4px 0px rgba(0,0,0,0.3);\n}\n\n.message.user {\n  background: #dddddd !important;\n  color: #000 !important;\n  border: 2px solid #000 !important;\n  border-radius: 0 !important;\n}\n\n/* Custom Ticker Tape for the Sidebar History Header */\n#sidebarHistory::before {\n  content: \"LOCAL WEATHER • FORECAST: CLOUDY WITH A CHANCE OF BUGS • HUMIDITY: 98% • \";\n  display: block;\n  background: var(--ticker-bg);\n  color: white;\n  white-space: nowrap;\n  padding: 4px;\n  font-size: 10px;\n  font-weight: bold;\n  overflow: hidden;\n  border-bottom: 2px solid #fff;\n}\n\n/* Scrollbar styling for that 90s chunky look */\n::-webkit-scrollbar {\n  width: 16px;\n  height: 16px;\n}\n\n::-webkit-scrollbar-track {\n  background: #888;\n  border: 1px solid #444;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #ccc;\n  border: 2px solid #fff;\n  border-right-color: #444;\n  border-bottom-color: #444;\n}\n\n.code-action-btn {\n  background: var(--accent-cyan) !important;\n  color: #000 !important;\n  border: 1px solid #000 !important;\n  border-radius: 0 !important;\n}\n\n#editorContainer {\n  border: 4px solid #002266;\n}\n\n.monaco-editor, .monaco-editor .margin, .monaco-editor-background {\n  background-color: #001133 !important;\n}\n\n.glow-text {\n  color: var(--accent-cyan) !important;\n  text-shadow: 0 0 8px var(--accent-cyan);\n}\n\n/* Settings Modal Broadcast Style */\n#settingsModal > div {\n  background: #003399 !important;\n  border: 4px solid #fff !important;\n  border-radius: 0 !important;\n}\n\n.settings-tab.active {\n  background: var(--accent-cyan) !important;\n  color: #000 !important;\n  border: none !important;\n  padding-left: 24px !important;\n}\n\n.setting-item {\n  border-bottom: 2px solid rgba(255,255,255,0.2) !important;\n}"
}