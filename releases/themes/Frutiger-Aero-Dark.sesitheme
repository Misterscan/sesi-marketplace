{
  "metadata": {
    "name": "Frutiger Aero Dark",
    "version": "1.0.0",
    "description": "Frutiger Aero in dark mode.",
    "author": "Community",
    "icon": "data:image/svg+xml;base64,",
    "commands": [
      "Apply Frutiger Dark"
    ],
    "license": "MIT"
  },
  "css": "\n\n\n:root {\n  --bg-base: #060e17;\n  --bg-panel: rgba(10, 28, 48, 0.75);\n  --accent-cyan: #00f0ff;\n  --accent-blue: #0078d7;\n  --accent-green: #00ffaa;\n  --silver-light: #e2f1ff;\n  --silver-mid: #8bb2cc;\n  --silver-dark: #4a6b82;\n  --glass-bg: rgba(8, 22, 38, 0.65);\n  --glass-border: rgba(200, 240, 255, 0.25);\n  --glass-highlight: rgba(255, 255, 255, 0.35);\n}\n\n/* Global Body & Background Aurora */\nbody {\n  font-family: 'Segoe UI', 'Calibri', 'Space Grotesk', sans-serif;\n  background: \n    radial-gradient(circle at 50% -20%, rgba(0, 240, 255, 0.18), transparent 60%), \n    radial-gradient(circle at 15% 80%, rgba(0, 255, 170, 0.1), transparent 50%), \n    radial-gradient(circle at 85% 70%, rgba(0, 120, 215, 0.15), transparent 50%),\n    #060e17;\n  background-size: cover;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* Header Bar - Glossy Aero Glass */\nheader {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.03) 50%, rgba(0, 0, 0, 0.25) 50.1%, rgba(0, 0, 0, 0.45) 100%) !important;\n  backdrop-filter: blur(20px) saturate(140%) !important;\n  -webkit-backdrop-filter: blur(20px) saturate(140%) !important;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.3) !important;\n  box-shadow: 0 4px 20px rgba(0, 240, 255, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.2);\n}\n\n.brand h1 {\n  font-family: 'Segoe UI', sans-serif;\n  font-weight: 700;\n  color: #ffffff;\n  text-shadow: 0 0 12px rgba(0, 240, 255, 0.6), 0 1px 3px rgba(0,0,0,0.5);\n}\n\n.glow-text {\n  color: var(--accent-cyan) !important;\n  text-shadow: 0 0 10px rgba(0, 240, 255, 0.8);\n}\n\n/* Buttons - Skeuomorphic Glossy Gel Capsules */\n.btn {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(0, 0, 0, 0.2) 50.1%, rgba(0, 0, 0, 0.4) 100%), #16355c !important;\n  border: 1px solid rgba(255, 255, 255, 0.35) !important;\n  color: #ffffff !important;\n  border-radius: 20px !important; /* Rounded pill style of the 2000s */\n  font-weight: 600;\n  text-shadow: 0 -1px 1px rgba(0, 0, 0, 0.6);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 2px 6px rgba(0, 0, 0, 0.4);\n  transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;\n  padding: 6px 16px !important;\n}\n\n.btn:hover {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.1) 50%, rgba(0, 0, 0, 0.1) 50.1%, rgba(0, 0, 0, 0.3) 100%), #0088cc !important;\n  border-color: var(--accent-cyan) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 0 12px rgba(0, 240, 255, 0.6);\n  transform: translateY(-1px);\n}\n\n.btn:active {\n  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.1) 100%) !important;\n  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.6);\n  transform: translateY(1px);\n}\n\n/* Specific Run Button - Green Gel */\n#runBtn {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(0, 0, 0, 0.2) 50.1%, rgba(0, 0, 0, 0.4) 100%), #0e6b3e !important;\n  border-color: rgba(0, 255, 170, 0.4) !important;\n}\n\n#runBtn:hover {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.1) 50%, rgba(0, 0, 0, 0.1) 50.1%, rgba(0, 0, 0, 0.3) 100%), #00cc7a !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5), 0 0 15px rgba(0, 255, 170, 0.7);\n}\n\n/* Panels - Aero Glass Containers */\n.panel {\n  background: var(--glass-bg) !important;\n  backdrop-filter: blur(16px) saturate(120%) !important;\n  -webkit-backdrop-filter: blur(16px) saturate(120%) !important;\n  border-right: 1px solid var(--glass-border) !important;\n  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05), 0 4px 12px rgba(0, 0, 0, 0.25);\n}\n\n.panel-header {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.01) 50%, rgba(0, 0, 0, 0.15) 50.1%, rgba(0, 0, 0, 0.3) 100%) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n  height: 38px !important;\n}\n\n.panel-title {\n  font-family: 'Segoe UI', sans-serif;\n  font-weight: 700;\n  letter-spacing: 0.8px;\n  color: #ffffff !important;\n  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5), 0 0 8px rgba(0, 240, 255, 0.4);\n}\n\n/* File Tree & Sidebar */\n#fileTree {\n  padding: 12px 0 !important;\n}\n\n.file-item {\n  margin: 2px 8px !important;\n  border-radius: 6px !important;\n  border: 1px solid transparent;\n  transition: all 0.15s ease-in-out !important;\n}\n\n.file-item:hover {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.02) 100%) !important;\n  border-color: rgba(0, 240, 255, 0.2) !important;\n  color: #ffffff !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);\n}\n\n.file-item.active {\n  background: linear-gradient(to bottom, rgba(0, 240, 255, 0.2) 0%, rgba(0, 120, 215, 0.2) 100%) !important;\n  border: 1px solid rgba(0, 240, 255, 0.4) !important;\n  color: var(--accent-cyan) !important;\n  font-weight: 600;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 8px rgba(0, 240, 255, 0.3);\n}\n\n/* Tabs - Rounded Glass Tabs */\n.tab-bar {\n  background: rgba(4, 12, 22, 0.5) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n  padding-top: 4px !important;\n  height: 40px !important;\n}\n\n.tab {\n  border-radius: 8px 8px 0 0 !important;\n  margin-left: 4px !important;\n  border: 1px solid rgba(255, 255, 255, 0.15) !important;\n  border-bottom: none !important;\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 0%, rgba(0, 0, 0, 0.3) 100%) !important;\n  transition: all 0.2s ease !important;\n  height: calc(100% - 1px) !important;\n}\n\n.tab:hover {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 0%, rgba(0, 0, 0, 0.2) 100%) !important;\n  color: #ffffff !important;\n  border-color: rgba(0, 240, 255, 0.3) !important;\n}\n\n.tab.active {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.02) 50%, rgba(0, 0, 0, 0.1) 50.1%, var(--bg-base) 100%) !important;\n  color: #ffffff !important;\n  border-color: rgba(255, 255, 255, 0.3) !important;\n  border-top: 3px solid var(--accent-cyan) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);\n  font-weight: 600;\n}\n\n/* Editor Container Overrides */\n#editorContainer {\n  background-color: var(--bg-base) !important;\n}\n\n.monaco-editor, .monaco-editor .margin, .monaco-editor-background {\n  background-color: #060e17 !important;\n}\n\n/* Terminal Panel - Dark Glass Console */\n.terminal-container-wrapper {\n  border-top: 1px solid var(--glass-border) !important;\n  background: rgba(3, 8, 15, 0.9) !important;\n  box-shadow: inset 0 4px 12px rgba(0, 0, 0, 0.5);\n}\n\n#terminalContainer {\n  padding: 12px !important;\n}\n\n/* Co-Pilot Chat Bubbles - Glossy Skeuomorphic Bubbles */\n.chat-messages {\n  background: rgba(4, 12, 22, 0.4) !important;\n}\n\n.message {\n  border-radius: 14px !important;\n  padding: 12px 16px !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 3px 8px rgba(0, 0, 0, 0.3);\n  border: 1px solid rgba(255, 255, 255, 0.1) !important;\n  max-width: 85% !important;\n}\n\n.message.system {\n  background: linear-gradient(135deg, rgba(10, 35, 60, 0.8) 0%, rgba(5, 20, 35, 0.8) 100%) !important;\n  border-left: 4px solid var(--accent-cyan) !important;\n  color: #e2f1ff !important;\n}\n\n.message.user {\n  background: linear-gradient(135deg, rgba(0, 120, 215, 0.6) 0%, rgba(0, 60, 120, 0.6) 100%) !important;\n  border-right: 4px solid var(--accent-blue) !important;\n  color: #ffffff !important;\n  align-self: flex-end !important;\n}\n\n.message pre {\n  background: rgba(2, 6, 12, 0.85) !important;\n  border: 1px solid rgba(0, 240, 255, 0.2) !important;\n  border-radius: 8px !important;\n  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.5);\n}\n\n/* Chat Input Area */\n.chat-input-area {\n  background: rgba(5, 15, 28, 0.8) !important;\n  border-top: 1px solid var(--glass-border) !important;\n  padding: 14px !important;\n}\n\n.chat-input {\n  background: rgba(0, 0, 0, 0.4) !important;\n  border: 1px solid rgba(255, 255, 255, 0.2) !important;\n  border-radius: 20px !important; /* Rounded pill input */\n  padding: 8px 16px !important;\n  color: #ffffff !important;\n  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);\n  transition: all 0.2s ease;\n}\n\n.chat-input:focus {\n  border-color: var(--accent-cyan) !important;\n  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4), 0 0 10px rgba(0, 240, 255, 0.4) !important;\n}\n\n/* Settings Modal - High Fidelity Aero Dialog */\n#settingsModal > div {\n  background: linear-gradient(135deg, rgba(12, 32, 56, 0.95) 0%, rgba(6, 18, 32, 0.95) 100%) !important;\n  backdrop-filter: blur(25px) saturate(150%) !important;\n  -webkit-backdrop-filter: blur(25px) saturate(150%) !important;\n  border: 1px solid rgba(255, 255, 255, 0.4) !important;\n  border-radius: 16px !important;\n  box-shadow: 0 25px 60px rgba(0, 240, 255, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.3) !important;\n}\n\n.settings-tab {\n  border-radius: 0 20px 20px 0 !important;\n  margin: 4px 0 !important;\n  transition: all 0.2s ease !important;\n}\n\n.settings-tab:hover {\n  background: rgba(0, 240, 255, 0.1) !important;\n  color: #ffffff !important;\n}\n\n.settings-tab.active {\n  background: linear-gradient(90deg, rgba(0, 120, 215, 0.4), transparent) !important;\n  color: var(--accent-cyan) !important;\n  border-left: 4px solid var(--accent-cyan) !important;\n  font-weight: bold;\n}\n\n/* Scrollbars - Glassy Vista Style */\n::-webkit-scrollbar {\n  width: 10px !important;\n  height: 10px !important;\n}\n\n::-webkit-scrollbar-track {\n  background: rgba(4, 12, 22, 0.5) !important;\n  border-radius: 10px !important;\n  border: 1px solid rgba(255, 255, 255, 0.05) !important;\n}\n\n::-webkit-scrollbar-thumb {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(0, 0, 0, 0.15) 50.1%, rgba(0, 0, 0, 0.3) 100%), rgba(0, 120, 215, 0.4) !important;\n  border: 1px solid rgba(255, 255, 255, 0.2) !important;\n  border-radius: 10px !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 1px 3px rgba(0, 0, 0, 0.4) !important;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.1) 50%, rgba(0, 0, 0, 0.05) 50.1%, rgba(0, 0, 0, 0.2) 100%), rgba(0, 240, 255, 0.5) !important;\n  border-color: var(--accent-cyan) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 0 8px rgba(0, 240, 255, 0.5) !important;\n}\n\n/* Chat Tabs - Aero Style */\n.chat-tabs {\n  background: rgba(3, 10, 20, 0.6) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n  padding-top: 2px !important;\n}\n\n.chat-tab {\n  border: 1px solid rgba(255, 255, 255, 0.1) !important;\n  border-bottom: none !important;\n  background: rgba(0, 0, 0, 0.2) !important;\n  border-radius: 6px 6px 0 0 !important;\n  margin-left: 4px !important;\n  transition: all 0.15s ease !important;\n}\n\n.chat-tab:hover {\n  background: rgba(255, 255, 255, 0.08) !important;\n  color: #ffffff !important;\n}\n\n.chat-tab.active {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 0%, rgba(0, 240, 255, 0.1) 100%) !important;\n  border-color: rgba(0, 240, 255, 0.3) !important;\n  color: var(--accent-cyan) !important;\n  font-weight: bold !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);\n}\n\n/* Code Action Buttons - Mini Gel Capsules */\n.code-action-btn {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.05) 50%, rgba(0, 0, 0, 0.15) 50.1%, rgba(0, 0, 0, 0.3) 100%), rgba(10, 35, 60, 0.8) !important;\n  border: 1px solid rgba(255, 255, 255, 0.2) !important;\n  color: var(--accent-cyan) !important;\n  border-radius: 10px !important;\n  text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.5);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 1px 2px rgba(0, 0, 0, 0.3);\n  transition: all 0.15s ease !important;\n}\n\n.code-action-btn:hover {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.1) 50%, rgba(0, 0, 0, 0.05) 50.1%, rgba(0, 0, 0, 0.2) 100%), rgba(0, 240, 255, 0.3) !important;\n  border-color: var(--accent-cyan) !important;\n  color: #ffffff !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 8px rgba(0, 240, 255, 0.4);\n}\n\n/* Settings Items */\n.setting-item {\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n}\n\n.setting-title {\n  font-family: 'Segoe UI', sans-serif;\n  font-weight: 600;\n  color: #ffffff !important;\n}\n\n.setting-desc {\n  color: var(--silver-mid) !important;\n}\n\n/* Checkboxes & Selects - Aero Style */\ninput[type=\"checkbox\"] {\n  appearance: none;\n  -webkit-appearance: none;\n  width: 18px;\n  height: 18px;\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  border-radius: 4px;\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.1), rgba(0, 0, 0, 0.3));\n  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);\n  cursor: pointer;\n  position: relative;\n  outline: none;\n  transition: all 0.15s ease;\n}\n\ninput[type=\"checkbox\"]:checked {\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.3) 0%, rgba(0, 240, 255, 0.4) 100%), #0078d7;\n  border-color: var(--accent-cyan);\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 0 8px rgba(0, 240, 255, 0.5);\n}\n\ninput[type=\"checkbox\"]:checked::after {\n  content: '✓';\n  position: absolute;\n  top: -1px;\n  left: 3px;\n  color: #ffffff;\n  font-size: 13px;\n  font-weight: bold;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);\n}\n\nselect {\n  appearance: none;\n  -webkit-appearance: none;\n  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.02) 50%, rgba(0, 0, 0, 0.15) 50.1%, rgba(0, 0, 0, 0.3) 100%), rgba(10, 32, 56, 0.8) !important;\n  border: 1px solid rgba(255, 255, 255, 0.25) !important;\n  border-radius: 12px !important;\n  color: #ffffff !important;\n  padding: 4px 24px 4px 12px !important;\n  font-family: 'Segoe UI', sans-serif;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 1px 3px rgba(0, 0, 0, 0.3);\n  cursor: pointer;\n  outline: none;\n}\n\nselect:focus {\n  border-color: var(--accent-cyan) !important;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 10px rgba(0, 240, 255, 0.5) !important;\n}\n\n/* High-density layout adjustments */\n.studio-container {\n  background: transparent !important;\n}"
}