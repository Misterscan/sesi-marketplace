{
  "metadata": {
    "name": "WinXP",
    "version": "1.0.0",
    "description": "Classic Windows XP Luna desktop theme for Sesi Studio.",
    "author": "Misterscan",
    "icon": "data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%0A%20%20%3Crect%20width%3D%22100%22%20height%3D%22100%22%20fill%3D%22%235ba4e5%22%2F%3E%0A%20%20%3Cellipse%20cx%3D%2225%22%20cy%3D%2230%22%20rx%3D%2212%22%20ry%3D%226%22%20fill%3D%22%23ffffff%22%20opacity%3D%220.8%22%2F%3E%0A%20%20%3Cellipse%20cx%3D%2275%22%20cy%3D%2225%22%20rx%3D%2215%22%20ry%3D%227%22%20fill%3D%22%23ffffff%22%20opacity%3D%220.6%22%2F%3E%0A%20%20%3Cellipse%20cx%3D%2250%22%20cy%3D%2215%22%20rx%3D%2210%22%20ry%3D%225%22%20fill%3D%22%23ffffff%22%20opacity%3D%220.7%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M-10%20110%20V%2065%20Q%2045%2045%20110%2075%20V%20110%20Z%22%20fill%3D%22%234caf50%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M-10%20110%20V%2080%20Q%2060%2060%20110%2085%20V%20110%20Z%22%20fill%3D%22%23388e3c%22%2F%3E%0A%3C%2Fsvg%3E",
    "commands": [
      "Apply WinXP"
    ],
    "license": "MIT"
  },
  "css": "\n\n\n:root {\n  --bg-base: #D6D3C4;\n  --bg-panel: #ECE9D8;\n  --accent-cyan: #0058E3;\n  --accent-blue: #245DD7;\n  --accent-green: #43B02A;\n  --silver-light: #000000;\n  --silver-mid: #333333;\n  --silver-dark: #7F7F7F;\n  --glass-bg: #ECE9D8;\n  --glass-border: #919B9C;\n  --glass-highlight: #FFFFFF;\n}\n\n/* Global Overrides */\nbody {\n  font-family: Tahoma, \"Segoe UI\", sans-serif !important;\n  background-color: var(--bg-base);\n  color: var(--silver-light);\n}\n\n/* Scrollbars */\n::-webkit-scrollbar {\n  width: 16px;\n  height: 16px;\n}\n::-webkit-scrollbar-track {\n  background: #EFEFDE;\n  border: 1px solid #D6D3C4;\n}\n::-webkit-scrollbar-thumb {\n  background: #C2D3FC;\n  border: 1px solid #316AC5;\n  box-shadow: inset 1px 1px 0px #FFF;\n}\n::-webkit-scrollbar-button {\n  display: block;\n  background: #ECE9D8;\n  border: 1px solid #919B9C;\n  height: 16px;\n  width: 16px;\n}\n\n/* Header Bar */\nheader {\n  background: linear-gradient(to bottom, #0058E3 0%, #3F8DF1 30%, #0058E3 100%) !important;\n  border-bottom: 2px solid #003C74 !important;\n  height: 40px !important;\n  padding: 0 8px !important;\n  box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.6);\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n}\n\n.brand img {\n  filter: drop-shadow(1px 1px 1px rgba(0,0,0,0.5));\n}\n\n.brand h1 {\n  color: #FFFFFF !important;\n  font-family: Tahoma, sans-serif;\n  font-weight: bold;\n  font-size: 14px !important;\n  text-shadow: 1px 1px 2px #00205B;\n}\n\n.glow-text {\n  color: #FFD700 !important;\n  text-shadow: none !important;\n  font-weight: bold;\n}\n\n/* Buttons */\n.btn {\n  background: linear-gradient(to bottom, #FCFCFC 0%, #F1ECE2 100%) !important;\n  border: 1px solid #003C74 !important;\n  color: #000000 !important;\n  border-radius: 3px !important;\n  box-shadow: inset 1px 1px 0px #fff, 1px 1px 1px rgba(0,0,0,0.15) !important;\n  font-family: Tahoma, sans-serif !important;\n  font-weight: normal !important;\n  font-size: 11px !important;\n  padding: 3px 12px !important;\n}\n\n.btn:hover {\n  background: linear-gradient(to bottom, #FFF 0%, #E3E3E3 100%) !important;\n  border-color: #E59700 !important;\n  box-shadow: inset 1px 1px 0px #fff, 0 0 3px #FFB700 !important;\n}\n\n.btn:active {\n  background: linear-gradient(to bottom, #E3E3E3 0%, #F1ECE2 100%) !important;\n  box-shadow: inset -1px -1px 0px #fff !important;\n  transform: none !important;\n}\n\n/* Panels Base */\n.panel {\n  background: #ECE9D8 !important;\n  border-right: 2px solid #D6D3C4 !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n}\n\n.panel-header {\n  background: linear-gradient(to right, #0058E3 0%, #3F8DF1 100%) !important;\n  border-bottom: 1px solid #003C74 !important;\n  height: 26px !important;\n  padding: 0 6px !important;\n}\n\n.panel-title {\n  color: #FFFFFF !important;\n  font-family: Tahoma, sans-serif !important;\n  font-weight: bold !important;\n  text-transform: none !important;\n  font-size: 11px !important;\n  letter-spacing: 0px !important;\n}\n\n/* File Tree Panel */\n#fileTree {\n  background: #FFFFFF !important;\n  border: 2px inset #7F9DB9 !important;\n  margin: 4px !important;\n  padding: 2px 0 !important;\n  list-style: none;\n}\n\n.file-item {\n  color: #000000 !important;\n  font-family: Tahoma, sans-serif !important;\n  font-size: 11px !important;\n  padding: 3px 6px !important;\n}\n\n.file-item:hover {\n  background: #316AC5 !important;\n  color: #FFFFFF !important;\n}\n\n.file-item.active {\n  background: #316AC5 !important;\n  color: #FFFFFF !important;\n  border-left: none !important;\n  font-weight: normal !important;\n}\n\n/* Tabs */\n.tab-bar {\n  background: #D6D3C4 !important;\n  border-bottom: 2px solid #919B9C !important;\n  padding-top: 4px;\n  padding-left: 4px;\n  height: 30px !important;\n}\n\n.tab {\n  background: linear-gradient(to bottom, #EAE8DB, #D6D3C4) !important;\n  border: 1px solid #919B9C !important;\n  border-bottom: none !important;\n  border-radius: 4px 4px 0 0 !important;\n  color: #000000 !important;\n  margin-right: 2px !important;\n  height: 26px !important;\n  font-family: Tahoma, sans-serif !important;\n  font-size: 11px !important;\n}\n\n.tab.active {\n  background: #FFFFFF !important;\n  border: 1px solid #919B9C !important;\n  border-bottom: 2px solid #FFFFFF !important;\n  font-weight: bold !important;\n  height: 28px !important;\n  margin-top: -2px !important;\n  z-index: 5 !important;\n}\n\n.tab-close {\n  color: #808080 !important;\n}\n\n.tab-close:hover {\n  background-color: #E0430A !important;\n  color: #FFFFFF !important;\n  border-radius: 2px;\n}\n\n/* Editor Overrides for Notepad Feel */\n.monaco-editor, \n.monaco-editor .margin, \n.monaco-editor .monaco-editor-background {\n  background-color: #FFFFFF !important;\n}\n\n.monaco-editor .line-numbers {\n  color: #808080 !important;\n}\n\n.monaco-editor .view-line {\n  color: #000000 !important;\n}\n\n/* Terminal Panel */\n.terminal-container-wrapper {\n  border-top: 2px solid #D6D3C4 !important;\n  background: #000000 !important;\n}\n\n#terminalContainer {\n  background: #000000 !important;\n  border: 2px inset #FFFFFF !important;\n  margin: 4px !important;\n}\n\n/* Co-Pilot Panel (Right Side) */\n.copilot-panel {\n  border-left: 2px solid #D6D3C4 !important;\n}\n\n.chat-messages {\n  background: #FFFFFF !important;\n  border: 2px inset #7F9DB9 !important;\n  margin: 4px !important;\n}\n\n.chat-tabs {\n  background: #D6D3C4 !important;\n  border-bottom: 1px solid #919B9C !important;\n  height: 26px !important;\n}\n\n.chat-tab {\n  background: #EAE8DB !important;\n  border-right: 1px solid #919B9C !important;\n  color: #000000 !important;\n  font-family: Tahoma, sans-serif !important;\n}\n\n.chat-tab.active {\n  background: #FFFFFF !important;\n  color: #0058E3 !important;\n  font-weight: bold !important;\n}\n\n.message.system {\n  background: #FFFFE1 !important; /* Classic XP Tooltip Yellow */\n  border: 1px solid #000000 !important;\n  color: #000000 !important;\n  border-radius: 0px !important;\n  font-family: Tahoma, sans-serif !important;\n  box-shadow: 2px 2px 4px rgba(0,0,0,0.15);\n}\n\n.message.user {\n  background: #ECE9D8 !important;\n  border: 1px solid #919B9C !important;\n  color: #000000 !important;\n  border-radius: 0px !important;\n  font-family: Tahoma, sans-serif !important;\n}\n\n.message pre {\n  background: #F1ECE2 !important;\n  border: 1px solid #919B9C !important;\n  color: #000000 !important;\n}\n\n.code-actions-header {\n  background: #D6D3C4 !important;\n  border-bottom: 1px solid #919B9C !important;\n}\n\n.code-action-btn {\n  border: 1px solid #003C74 !important;\n  color: #003C74 !important;\n  background: #FFF !important;\n}\n\n.code-action-btn:hover {\n  background: #316AC5 !important;\n  color: #FFF !important;\n}\n\n.chat-input-area {\n  background: #ECE9D8 !important;\n  border-top: 1px solid #D6D3C4 !important;\n}\n\n.chat-input {\n  background: #FFFFFF !important;\n  border: 2px inset #7F9DB9 !important;\n  color: #000000 !important;\n  font-family: Tahoma, sans-serif !important;\n  border-radius: 0px !important;\n}\n\n.chat-input:focus {\n  border-color: #0058E3 !important;\n  box-shadow: none !important;\n}\n\n.chat-btn {\n  background: linear-gradient(to bottom, #FCFCFC 0%, #F1ECE2 100%) !important;\n  border: 1px solid #003C74 !important;\n  color: #000000 !important;\n  border-radius: 3px !important;\n  box-shadow: inset 1px 1px 0px #fff, 1px 1px 1px rgba(0,0,0,0.15) !important;\n}\n\n/* Local History / Timeline */\n#sidebarHistory {\n  background: #FFFFFF !important;\n  border: 2px inset #7F9DB9 !important;\n  margin: 4px !important;\n  padding: 4px !important;\n}\n\n#sidebarHistory .file-item {\n  border-bottom: 1px solid #EFEFDE !important;\n  background: #FFFFFF !important;\n  color: #000000 !important;\n}\n\n#sidebarHistory .file-item:hover {\n  background: #316AC5 !important;\n  color: #FFFFFF !important;\n}\n\n#sidebarHistory .file-item:hover span {\n  color: #FFFFFF !important;\n}\n\n#sidebarHistory button {\n  background: linear-gradient(to bottom, #FCFCFC 0%, #F1ECE2 100%) !important;\n  border: 1px solid #003C74 !important;\n  color: #000000 !important;\n  padding: 1px 6px !important;\n  border-radius: 2px !important;\n  font-family: Tahoma, sans-serif !important;\n  font-size: 10px !important;\n}\n\n#sidebarHistory button:hover {\n  background: linear-gradient(to bottom, #FFF 0%, #E3E3E3 100%) !important;\n}\n\n/* Settings Modal as XP Dialog Box */\n#settingsModal {\n  background: rgba(0, 0, 0, 0.4) !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n}\n\n#settingsModal > div {\n  background: #ECE9D8 !important;\n  border: 3px solid #0058E3 !important;\n  border-radius: 5px 5px 0px 0px !important;\n  box-shadow: 4px 4px 10px rgba(0,0,0,0.4) !important;\n  font-family: Tahoma, sans-serif !important;\n}\n\n/* Dialog Header */\n#settingsModal > div > div:first-child {\n  background: linear-gradient(to right, #0058E3 0%, #3F8DF1 100%) !important;\n  border-bottom: 1px solid #003C74 !important;\n  padding: 6px 10px !important;\n  height: 30px !important;\n}\n\n#settingsModal h2 {\n  color: #FFFFFF !important;\n  font-size: 12px !important;\n  font-weight: bold !important;\n  text-shadow: 1px 1px 1px #00205B !important;\n}\n\n#settingsModal h2 span {\n  display: none; /* Hide modern emoji */\n}\n\n/* Dialog Sidebar */\n#settingsModal div[style*=\"width: 200px\"] {\n  background: #D6D3C4 !important;\n  border-right: 2px solid #919B9C !important;\n  padding: 8px 0 !important;\n}\n\n.settings-tab {\n  color: #000000 !important;\n  font-family: Tahoma, sans-serif !important;\n  font-size: 11px !important;\n  padding: 6px 16px !important;\n  border-bottom: 1px solid #ECE9D8 !important;\n}\n\n.settings-tab:hover {\n  background: #316AC5 !important;\n  color: #FFFFFF !important;\n}\n\n.settings-tab.active {\n  background: #FFFFFF !important;\n  color: #000000 !important;\n  font-weight: bold !important;\n  border-left: 4px solid #F59E0B !important; /* XP Orange accent */\n  padding-left: 12px !important;\n}\n\n/* Settings Content */\n#settingsContent {\n  background: #FFFFFF !important;\n  border: 2px inset #7F9DB9 !important;\n  margin: 12px !important;\n  padding: 16px !important;\n  color: #000000 !important;\n}\n\n.settings-section h3 {\n  color: #0058E3 !important;\n  font-size: 12px !important;\n  font-weight: bold !important;\n  border-bottom: 1px solid #D6D3C4 !important;\n  padding-bottom: 4px !important;\n  margin-bottom: 12px !important;\n  text-transform: none !important;\n  letter-spacing: 0px !important;\n}\n\n.setting-item {\n  border-bottom: 1px dashed #D6D3C4 !important;\n  padding-bottom: 8px !important;\n  margin-bottom: 8px !important;\n}\n\n.setting-title {\n  color: #000000 !important;\n  font-weight: bold !important;\n  font-size: 11px !important;\n}\n\n.setting-desc {\n  color: #555555 !important;\n  font-size: 10px !important;\n}\n\n/* Form Controls in Settings */\n#settingsContent input[type=\"checkbox\"] {\n  accent-color: #0058E3;\n}\n\n#settingsContent input[type=\"number\"], \n#settingsContent select {\n  background: #FFFFFF !important;\n  border: 2px inset #7F9DB9 !important;\n  color: #000000 !important;\n  font-family: Tahoma, sans-serif !important;\n  font-size: 11px !important;\n  padding: 2px !important;\n}\n\n/* Theme Cards */\n#themeList > div {\n  background: #ECE9D8 !important;\n  border: 1px solid #919B9C !important;\n  border-radius: 3px !important;\n  color: #000000 !important;\n  box-shadow: 1px 1px 2px rgba(0,0,0,0.1) !important;\n}\n\n#themeList > div:hover {\n  border-color: #0058E3 !important;\n  background: #F1ECE2 !important;\n}\n\n/* Dialog Footer */\n#settingsModal div[style*=\"border-top\"] {\n  background: #ECE9D8 !important;\n  border-top: 1px solid #D6D3C4 !important;\n  padding: 8px 12px !important;\n  color: #555555 !important;\n  font-family: Tahoma, sans-serif !important;\n  font-size: 10px !important;\n}\n\n/* Custom XP Window Controls styling for Dialog Close */\n#settingsModal button[onclick=\"toggleSettingsModal()\"] {\n  background: linear-gradient(to bottom, #E0430A 0%, #F37A5A 40%, #A51F00 100%) !important;\n  border: 1px solid #701500 !important;\n  color: #FFFFFF !important;\n  font-weight: bold !important;\n  box-shadow: inset 1px 1px 0px #FF9F88 !important;\n  text-shadow: 1px 1px 1px #701500;\n  border-radius: 3px !important;\n  font-size: 11px !important;\n}\n\n#settingsModal button[onclick=\"toggleSettingsModal()\"]:hover {\n  background: linear-gradient(to bottom, #F37A5A 0%, #E0430A 100%) !important;\n  box-shadow: inset 1px 1px 0px #FF9F88, 0 0 3px #E0430A !important;\n}\n\n/* Brand logo styling to look like classic Windows flag */\n.brand img {\n  content: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path fill=\"%23F25022\" d=\"M1 1h10v10H1z\"/><path fill=\"%237FBA00\" d=\"M13 1h10v10H13z\"/><path fill=\"%2300A4EF\" d=\"M1 13h10v10H1z\"/><path fill=\"%23FFB900\" d=\"M13 13h10v10H13z\"/></svg>') !important;\n}"
}