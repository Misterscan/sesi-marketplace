{
  "metadata": {
    "name": "Y2K",
    "version": "1.0.0",
    "description": "A low-resolution digital aesthetic featuring 16-bit color constraints, beveled UI elements, and dithered gradients reminiscent of 90s multimedia software.",
    "icon": "data:image/svg+xml;base64,",
    "commands": [
      "Apply Y2K"
    ],
    "license": "MIT"
  },
  "css": "\n\n\n:root {\n  --bg-base: #101020;\n  --bg-panel: #222233;\n  --accent-cyan: #00ffff;\n  --accent-blue: #5555ff;\n  --accent-green: #00ff00;\n  --silver-light: #dfdfdf;\n  --silver-mid: #808080;\n  --silver-dark: #404040;\n  --glass-bg: #1a1a2a;\n  --glass-border: #555577;\n  --glass-highlight: #ffffff;\n  \n  /* Dither Patterns */\n  --dither-pattern: url(\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAYAAABytg0kAAAAFElEQVQImWMQFBRkYGBgYGAECQAAHwAB6Y6Z3QAAAABJRU5ErkJggg==\");\n}\n\nbody {\n  image-rendering: pixelated;\n  background-color: var(--bg-base);\n  background-image: var(--dither-pattern);\n  background-size: 2px 2px;\n  font-family: 'JetBrains Mono', 'Courier New', monospace !important;\n  letter-spacing: 0px;\n}\n\nheader {\n  background: #000080 !important; /* Classic Win95 Title Blue */\n  border-bottom: 2px solid var(--silver-dark);\n  box-shadow: inset 0 -1px 0 #000;\n  height: 40px !important;\n}\n\n.brand h1 {\n  font-family: 'JetBrains Mono', monospace;\n  text-transform: uppercase;\n  font-weight: 900;\n  color: #fff;\n  text-shadow: 2px 2px #000;\n}\n\n.glow-text {\n  color: var(--accent-cyan) !important;\n  text-shadow: 1px 1px #000;\n}\n\n/* Beveled Panels */\n.panel {\n  background: var(--bg-panel) !important;\n  border: 2px solid !important;\n  border-color: var(--silver-light) var(--silver-dark) var(--silver-dark) var(--silver-light) !important;\n  margin: 2px;\n}\n\n.panel-header {\n  background: repeating-linear-gradient(45deg, #333344, #333344 2px, #222233 2px, #222233 4px) !important;\n  border-bottom: 2px solid var(--silver-dark) !important;\n  height: 28px !important;\n}\n\n.panel-title {\n  font-size: 10px !important;\n  color: #fff !important;\n  text-shadow: 1px 1px #000;\n}\n\n/* 16-bit Buttons */\n.btn {\n  background: var(--silver-mid) !important;\n  border: 2px solid !important;\n  border-color: var(--silver-light) var(--silver-dark) var(--silver-dark) var(--silver-light) !important;\n  border-radius: 0px !important;\n  color: #000 !important;\n  font-family: 'JetBrains Mono', monospace !important;\n  font-weight: bold !important;\n  text-transform: uppercase;\n  padding: 4px 10px !important;\n}\n\n.btn:hover {\n  background: var(--silver-light) !important;\n}\n\n.btn:active {\n  border-color: var(--silver-dark) var(--silver-light) var(--silver-light) var(--silver-dark) !important;\n  padding: 5px 9px 3px 11px !important;\n}\n\n/* Tabs */\n.tab-bar {\n  background: #111 !important;\n  height: 30px !important;\n  padding-top: 4px;\n}\n\n.tab {\n  background: var(--silver-mid) !important;\n  border: 2px solid !important;\n  border-color: var(--silver-light) var(--silver-dark) transparent var(--silver-light) !important;\n  border-radius: 4px 4px 0 0 !important;\n  margin-right: 2px;\n  color: #000 !important;\n  font-size: 11px !important;\n}\n\n.tab.active {\n  background: var(--bg-panel) !important;\n  color: var(--accent-cyan) !important;\n  border-bottom: 2px solid var(--bg-panel) !important;\n  margin-top: -2px;\n  height: calc(100% + 2px);\n  z-index: 2;\n}\n\n/* File Tree */\n.file-item {\n  border: 1px solid transparent;\n}\n\n.file-item:hover {\n  background: var(--accent-blue) !important;\n  color: #fff !important;\n  border: 1px dotted #fff;\n}\n\n.file-item.active {\n  background: #000080 !important;\n  color: #fff !important;\n  border: 1px dotted var(--accent-cyan) !important;\n}\n\n/* Chat Messages */\n.chat-messages {\n  background-image: var(--dither-pattern) !important;\n  background-color: #000 !important;\n}\n\n.message {\n  border-radius: 0px !important;\n  border: 2px solid !important;\n  font-size: 12px !important;\n}\n\n.message.system {\n  background: #222244 !important;\n  border-color: var(--silver-light) var(--silver-dark) var(--silver-dark) var(--silver-light) !important;\n  color: #fff !important;\n}\n\n.message.user {\n  background: #442244 !important;\n  border-color: var(--silver-light) var(--silver-dark) var(--silver-dark) var(--silver-light) !important;\n  color: var(--accent-cyan) !important;\n}\n\n.message pre {\n  background: #000 !important;\n  border: 1px solid var(--silver-mid) !important;\n  border-radius: 0px !important;\n}\n\n/* Terminal */\n.terminal-container-wrapper {\n  border-top: 4px double var(--silver-mid) !important;\n}\n\n.xterm-viewport {\n  background-color: #000 !important;\n}\n\n/* Scrollbars */\n::-webkit-scrollbar {\n  width: 16px;\n  height: 16px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--silver-mid);\n  background-image: var(--dither-pattern);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--silver-mid);\n  border: 2px solid;\n  border-color: var(--silver-light) var(--silver-dark) var(--silver-dark) var(--silver-light);\n}\n\n::-webkit-scrollbar-thumb:active {\n  border-color: var(--silver-dark) var(--silver-light) var(--silver-light) var(--silver-dark);\n}\n\n/* Inputs */\n.chat-input {\n  background: #000 !important;\n  border: 2px solid !important;\n  border-color: var(--silver-dark) var(--silver-light) var(--silver-light) var(--silver-dark) !important;\n  border-radius: 0px !important;\n  color: var(--accent-green) !important;\n  font-family: 'JetBrains Mono', monospace;\n}\n\n/* Monaco Overrides */\n.monaco-editor, .monaco-editor .margin, .monaco-editor-background {\n  background-color: #000 !important;\n}\n\n.monaco-editor .line-numbers {\n  color: var(--silver-mid) !important;\n}\n\n.monaco-editor .current-line {\n  background-color: rgba(255, 255, 255, 0.05) !important;\n  border: 1px dotted var(--silver-mid);\n}\n\n/* Settings Modal */\n#settingsModal > div {\n  border-radius: 0px !important;\n  border: 3px solid var(--silver-light) !important;\n  box-shadow: 10px 10px 0px rgba(0,0,0,0.5) !important;\n}\n\n.settings-tab.active {\n  background: #000080 !important;\n  color: #fff !important;\n  border: 1px dotted #fff !important;\n}\n\n.setting-item {\n  border-bottom: 1px dashed var(--silver-dark) !important;\n}\n\n/* Code Action Buttons */\n.code-action-btn {\n  border-radius: 0px !important;\n  background: var(--silver-mid) !important;\n  border: 1px solid !important;\n  border-color: var(--silver-light) var(--silver-dark) var(--silver-dark) var(--silver-light) !important;\n  color: #000 !important;\n}\n\n.code-action-btn:hover {\n  background: var(--accent-cyan) !important;\n  color: #000 !important;\n}\n\n/* CRT Scanline Overlay Effect (Optional/Subtle) */\n.studio-container::after {\n  content: \" \";\n  display: block;\n  position: absolute;\n  top: 0;\n  left: 0;\n  bottom: 0;\n  right: 0;\n  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02));\n  z-index: 9999;\n  background-size: 100% 4px, 3px 100%;\n  pointer-events: none;\n}"
}