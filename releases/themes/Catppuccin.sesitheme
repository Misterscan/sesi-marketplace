{
  "metadata": {
    "name": "Catppuccin",
    "version": "1.0.0",
    "description": "A community-favorite soft pastel theme. Balances muted colors like rosewater, lavender, and blue to create a low-contrast, easy-on-the-eyes aesthetic.",
    "author": "Community",
    "icon": "data:image/svg+xml;utf8,%3Csvg%20width%3D%22100%22%20height%3D%22100%22%20viewBox%3D%220%200%20100%20100%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%0A%20%20%3Crect%20width%3D%22100%22%20height%3D%22100%22%20rx%3D%2220%22%20fill%3D%22%231e1e2e%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2230%22%20cy%3D%2235%22%20r%3D%2212%22%20fill%3D%22%23f5e0dc%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2270%22%20cy%3D%2235%22%20r%3D%2212%22%20fill%3D%22%23f5e0dc%22%2F%3E%0A%20%20%3Crect%20x%3D%2220%22%20y%3D%2242%22%20width%3D%2260%22%20height%3D%2238%22%20rx%3D%2219%22%20fill%3D%22%23b4befe%22%2F%3E%3Ccircle%20cx%3D%2250%22%20cy%3D%2261%22%20r%3D%2210%22%20fill%3D%22%2389b4fa%22%2F%3E%3C%2Fsvg%3E",
    "commands": [
      "Apply Catppuccin"
    ],
    "license": "MIT"
  },
  "css": "\n\n\n:root {\n  --bg-base: #1e1e2e;\n  --bg-panel: #181825;\n  --accent-cyan: #b4befe; /* Lavender */\n  --accent-blue: #89b4fa; /* Blue */\n  --accent-green: #a6e3a1; /* Green */\n  --silver-light: #cdd6f4; /* Text */\n  --silver-mid: #a6adc8; /* Subtext0 */\n  --silver-dark: #585b70; /* Surface2 */\n  --glass-bg: rgba(24, 24, 37, 0.75);\n  --glass-border: rgba(180, 190, 254, 0.12);\n  --glass-highlight: rgba(180, 190, 254, 0.2);\n  \n  /* Catppuccin Specific Palette */\n  --ctp-rosewater: #f5e0dc;\n  --ctp-flamingo: #f2cdcd;\n  --ctp-pink: #f5c2e7;\n  --ctp-mauve: #cba6f7;\n  --ctp-red: #f38ba8;\n  --ctp-peach: #fab387;\n  --ctp-yellow: #f9e2af;\n  --ctp-teal: #94e2d5;\n  --ctp-sky: #89dceb;\n  --ctp-sapphire: #74c7ec;\n  --ctp-crust: #11111b;\n  --ctp-mantle: #181825;\n  --ctp-base: #1e1e2e;\n  --ctp-surface0: #313244;\n  --ctp-surface1: #45475a;\n  --ctp-surface2: #585b70;\n}\n\n/* Global Overrides */\nbody {\n  background-color: var(--ctp-base);\n  color: var(--ctp-rosewater);\n}\n\nheader {\n  background: rgba(24, 24, 37, 0.85) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n}\n\n.brand h1 {\n  color: var(--silver-light);\n}\n\n.glow-text {\n  color: var(--ctp-pink) !important;\n  text-shadow: 0 0 10px rgba(245, 194, 231, 0.2);\n}\n\n/* Buttons */\n.btn {\n  background: var(--ctp-surface0);\n  border: 1px solid var(--ctp-surface1);\n  color: var(--silver-light);\n}\n\n.btn:hover {\n  background: var(--ctp-surface1);\n  border-color: var(--accent-cyan);\n  color: #fff;\n}\n\n/* Panels */\n.panel {\n  background: var(--glass-bg);\n  border-right: 1px solid var(--glass-border);\n}\n\n.panel-header {\n  background: rgba(17, 17, 27, 0.4) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n}\n\n.panel-title {\n  color: var(--accent-cyan) !important;\n}\n\n/* File Tree */\n#fileTree {\n  background: transparent;\n}\n\n.file-item {\n  color: var(--silver-mid);\n}\n\n.file-item:hover {\n  background: rgba(180, 190, 254, 0.08) !important;\n  color: var(--ctp-rosewater) !important;\n}\n\n.file-item.active {\n  background: rgba(180, 190, 254, 0.15) !important;\n  border-left: 2px solid var(--accent-cyan) !important;\n  color: var(--accent-cyan) !important;\n}\n\n/* Tabs */\n.tab-bar {\n  background: rgba(17, 17, 27, 0.5) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n}\n\n.tab {\n  background: rgba(17, 17, 27, 0.2) !important;\n  border-right: 1px solid var(--glass-border) !important;\n  color: var(--silver-mid);\n}\n\n.tab.active {\n  background: var(--ctp-base) !important;\n  color: var(--silver-light) !important;\n  border-bottom: 2px solid var(--accent-cyan) !important;\n}\n\n.tab-close:hover {\n  color: var(--ctp-red) !important;\n}\n\n/* Terminal */\n.terminal-container-wrapper {\n  background: var(--ctp-crust) !important;\n  border-top: 1px solid var(--glass-border) !important;\n}\n\n/* Co-Pilot Chat */\n.chat-messages {\n  background: rgba(17, 17, 27, 0.3) !important;\n}\n\n.chat-tabs {\n  background: rgba(17, 17, 27, 0.5) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n}\n\n.chat-tab {\n  border-right: 1px solid var(--glass-border) !important;\n  color: var(--silver-mid);\n}\n\n.chat-tab.active {\n  background: rgba(180, 190, 254, 0.1) !important;\n  color: var(--accent-cyan) !important;\n}\n\n.chat-tab-add {\n  color: var(--accent-green) !important;\n}\n\n.chat-tab-close:hover {\n  color: var(--ctp-red) !important;\n}\n\n.message.system {\n  background: rgba(49, 50, 68, 0.4) !important;\n  border: 1px solid var(--glass-border) !important;\n  color: var(--silver-light) !important;\n}\n\n.message.user {\n  background: var(--ctp-surface0) !important;\n  border: 1px solid var(--glass-border) !important;\n  color: var(--silver-light) !important;\n}\n\n.message pre {\n  background: var(--ctp-crust) !important;\n  border: 1px solid var(--glass-border) !important;\n}\n\n.code-actions-header {\n  background: rgba(24, 24, 37, 0.9) !important;\n  border-bottom: 1px solid var(--glass-border) !important;\n}\n\n.code-action-btn {\n  border: 1px solid var(--accent-cyan) !important;\n  color: var(--accent-cyan) !important;\n}\n\n.code-action-btn:hover {\n  background: var(--accent-cyan) !important;\n  color: var(--ctp-crust) !important;\n}\n\n.message code {\n  color: var(--ctp-pink) !important;\n}\n\n.chat-input-area {\n  background: rgba(17, 17, 27, 0.4) !important;\n  border-top: 1px solid var(--glass-border) !important;\n}\n\n.chat-input {\n  background: var(--ctp-crust) !important;\n  border: 1px solid var(--ctp-surface1) !important;\n  color: var(--silver-light) !important;\n}\n\n.chat-input:focus {\n  border-color: var(--accent-cyan) !important;\n  box-shadow: 0 0 8px rgba(180, 190, 254, 0.2) !important;\n}\n\n/* Settings Modal */\n#settingsModal {\n  background: rgba(17, 17, 27, 0.85) !important;\n}\n\n#settingsModal > div {\n  background: var(--ctp-mantle) !important;\n  border: 1px solid var(--glass-border) !important;\n}\n\n.settings-tab:hover {\n  background: rgba(180, 190, 254, 0.08) !important;\n  color: #fff !important;\n}\n\n.settings-tab.active {\n  background: rgba(180, 190, 254, 0.15) !important;\n  color: var(--accent-cyan) !important;\n  border-left: 3px solid var(--accent-cyan) !important;\n}\n\n.settings-section h3 {\n  color: var(--accent-cyan) !important;\n}\n\n/* Scrollbars */\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--ctp-crust);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--ctp-surface0);\n  border-radius: 5px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--ctp-surface1);\n}"
}