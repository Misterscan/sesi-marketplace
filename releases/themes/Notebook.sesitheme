{
  "metadata": {
    "name": "Notebook",
    "version": "1.0.0",
    "description": "A cozy physical journal theme with paper textures and handwritten fonts.",
    "author": "Community",
    "icon": "📓",
    "commands": [
      "Apply Notebook"
    ]
  },
  "css": "\n\n@import url('https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Patrick+Hand&family=Fira+Mono:wght@400;500&display=swap');\n\n:root {\n  --bg-base: #fcf8f2;\n  --bg-panel: #f6f0e5;\n  --accent-cyan: #0066cc; /* Fountain pen blue */\n  --accent-blue: #004499; /* Deep indigo ink */\n  --accent-green: #1e6b3e; /* Forest green ink */\n  --silver-light: #2c2520; /* Dark charcoal ink */\n  --silver-mid: #5a504a; /* Pencil gray */\n  --silver-dark: #8c8075; /* Light pencil gray */\n  --glass-bg: rgba(246, 240, 229, 0.95);\n  --glass-border: #dcd0be;\n  --glass-highlight: rgba(255, 255, 255, 0.6);\n}\n\n/* Global Styles & Typography */\nbody {\n  background-color: var(--bg-base);\n  color: var(--silver-light);\n  font-family: 'Patrick Hand', cursive, sans-serif;\n  font-size: 15px;\n  background-image: linear-gradient(rgba(168, 195, 216, 0.15) 1px, transparent 1px);\n  background-size: 100% 24px;\n}\n\n/* Header Bar */\nheader {\n  background: #ebdcb9 !important;\n  border-bottom: 2px solid #8b7355 !important;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\n}\n\n.brand h1 {\n  font-family: 'Architects Daughter', cursive;\n  color: #5c4033 !important;\n  font-size: 18px;\n}\n\n.glow-text {\n  color: var(--accent-cyan) !important;\n  text-shadow: none !important;\n  font-weight: bold;\n}\n\n/* Hand-drawn Buttons */\n.btn {\n  background: #fdfdfd !important;\n  border: 2px solid #8b7355 !important;\n  border-radius: 255px 15px 225px 15px/15px 225px 15px 255px !important;\n  color: #5c4033 !important;\n  font-family: 'Architects Daughter', cursive !important;\n  font-size: 13px !important;\n  padding: 5px 15px !important;\n  box-shadow: 1px 2px 4px rgba(0,0,0,0.1) !important;\n  transition: transform 0.15s ease, box-shadow 0.15s ease !important;\n}\n\n.btn:hover {\n  background: #f5efe6 !important;\n  transform: translateY(-1px) rotate(-0.5deg) !important;\n  box-shadow: 2px 4px 8px rgba(0,0,0,0.12) !important;\n}\n\n.btn:active {\n  transform: translateY(1px) !important;\n  box-shadow: 0px 1px 2px rgba(0,0,0,0.1) !important;\n}\n\n/* Panels & Layout */\n.panel {\n  background: var(--bg-panel) !important;\n  border-right: 2px solid #dcd0be !important;\n  box-shadow: inset -3px 0 5px rgba(0,0,0,0.02);\n}\n\n.panel-header {\n  background: #ebdcb9 !important;\n  border-bottom: 2px dashed #b5a48c !important;\n  font-family: 'Architects Daughter', cursive !important;\n  color: #5c4033 !important;\n  height: 38px;\n}\n\n.panel-title {\n  font-size: 12px !important;\n  color: #5c4033 !important;\n  letter-spacing: 1px;\n}\n\n/* File Tree Sidebar */\n#fileTree {\n  font-family: 'Patrick Hand', cursive !important;\n  font-size: 16px !important;\n  background-image: linear-gradient(rgba(168, 195, 216, 0.2) 1px, transparent 1px);\n  background-size: 100% 26px;\n  line-height: 26px !important;\n  padding: 10px 0 !important;\n}\n\n.file-item {\n  padding: 0 16px !important;\n  height: 26px !important;\n  color: #4a3f35 !important;\n  transition: background 0.1s ease, color 0.1s ease !important;\n}\n\n.file-item:hover {\n  background: rgba(0, 102, 204, 0.06) !important;\n  color: var(--accent-cyan) !important;\n}\n\n.file-item.active {\n  background: rgba(0, 102, 204, 0.1) !important;\n  border-left: 4px solid var(--accent-cyan) !important;\n  color: var(--accent-blue) !important;\n  font-weight: bold !important;\n}\n\n/* Editor Section & Tabs */\n.editor-section {\n  background: #fdfbf7;\n}\n\n.editor-container-wrapper::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 48px;\n  bottom: 0;\n  width: 1px;\n  background: rgba(220, 70, 70, 0.4);\n  z-index: 10;\n  pointer-events: none;\n}\n\n.tab-bar {\n  background: #e6dfd3 !important;\n  border-bottom: 2px solid #b5a48c !important;\n  padding-top: 4px;\n  height: 38px;\n}\n\n.tab {\n  background: #dcd0be !important;\n  border: 1px solid #b5a48c !important;\n  border-bottom: none !important;\n  border-radius: 8px 8px 0 0 !important;\n  margin-right: 4px;\n  font-family: 'Patrick Hand', cursive !important;\n  font-size: 15px !important;\n  color: #5c4033 !important;\n  height: calc(100% - 1px) !important;\n}\n\n.tab.active {\n  background: #fdfbf7 !important;\n  color: var(--accent-blue) !important;\n  border-bottom: 2px solid #fdfbf7 !important;\n  font-weight: bold !important;\n  transform: translateY(-1px);\n}\n\n.tab-close:hover {\n  color: #cc3333 !important;\n}\n\n/* Monaco Editor Cozy Sepia Overrides */\n.monaco-editor, \n.monaco-editor .margin, \n.monaco-editor .monaco-editor-background {\n  background-color: #fdfbf7 !important;\n}\n\n.monaco-editor .line-numbers {\n  color: #a89f91 !important;\n  font-family: 'Fira Mono', monospace !important;\n  font-size: 11px !important;\n}\n\n.monaco-editor .current-line {\n  background-color: rgba(246, 240, 229, 0.8) !important;\n  border: none !important;\n}\n\n/* Monaco Token Custom Colors for Ink/Pencil Aesthetic */\n.mtk1 { color: #2c2520 !important; } /* Plain text */\n.mtk4 { color: #004499 !important; font-weight: bold !important; } /* Keywords */\n.mtk6 { color: #1e6b3e !important; } /* Strings */\n.mtk8 { color: #8c8075 !important; font-style: italic !important; } /* Comments */\n.mtk5 { color: #b22222 !important; } /* Numbers */\n.mtk7 { color: #0066cc !important; } /* Types / Builtins */\n\n/* Terminal Panel (Chalkboard style to contrast the paper) */\n.terminal-container-wrapper {\n  background: #2b2621 !important;\n  border-top: 3px solid #8b7355 !important;\n}\n\n.terminal-container-wrapper .panel-header {\n  background: #1e1a17 !important;\n  border-bottom: 1px solid #3e352f !important;\n}\n\n#terminalContainer {\n  background: #2b2621 !important;\n  padding: 10px !important;\n}\n\n.xterm-viewport, .xterm-screen {\n  background: #2b2621 !important;\n}\n\n/* Co-Pilot Sidebar */\n.copilot-panel {\n  border-left: 2px solid #dcd0be !important;\n}\n\n.chat-tabs {\n  background: #e6dfd3 !important;\n  border-bottom: 1px solid #b5a48c !important;\n}\n\n.chat-tab {\n  font-family: 'Architects Daughter', cursive !important;\n  color: #5c4033 !important;\n}\n\n.chat-tab.active {\n  background: #f3ebe0 !important;\n  color: var(--accent-blue) !important;\n}\n\n.chat-messages {\n  background: #f3ebe0 !important;\n  background-image: radial-gradient(#dcd0be 1.2px, transparent 0) !important;\n  background-size: 14px 14px !important;\n  font-family: 'Patrick Hand', cursive !important;\n  font-size: 16px !important;\n}\n\n.message {\n  border-radius: 12px 12px 12px 0 !important;\n  box-shadow: 1px 2px 6px rgba(0,0,0,0.06) !important;\n  line-height: 1.4 !important;\n}\n\n.message.system {\n  background: #fdfbf7 !important;\n  border: 1px solid #dcd0be !important;\n  color: #2c2520 !important;\n}\n\n.message.user {\n  background: #ebdcb9 !important;\n  border: 1px solid #b5a48c !important;\n  align-self: flex-end !important;\n  color: #2c2520 !important;\n  border-top-right-radius: 2px !important;\n}\n\n.message pre {\n  background: #fdfbf7 !important;\n  border: 1px solid #dcd0be !important;\n  border-radius: 6px !important;\n  font-family: 'Fira Mono', monospace !important;\n  font-size: 12px !important;\n  color: #2c2520 !important;\n  box-shadow: inset 1px 1px 3px rgba(0,0,0,0.05) !important;\n}\n\n.code-actions-header {\n  background: #ebdcb9 !important;\n  border-bottom: 1px solid #dcd0be !important;\n}\n\n.code-action-btn {\n  border: 1px solid #8b7355 !important;\n  color: #5c4033 !important;\n  font-family: 'Architects Daughter', cursive !important;\n  background: #fdfbf7 !important;\n  border-radius: 4px !important;\n}\n\n.code-action-btn:hover {\n  background: #ebdcb9 !important;\n  color: var(--accent-blue) !important;\n}\n\n.message code {\n  color: var(--accent-blue) !important;\n  font-family: 'Fira Mono', monospace !important;\n  background: rgba(0, 102, 204, 0.05) !important;\n  padding: 2px 4px !important;\n  border-radius: 4px !important;\n}\n\n.chat-input-area {\n  background: #ebdcb9 !important;\n  border-top: 2px solid #b5a48c !important;\n}\n\n.chat-input {\n  background: #fdfbf7 !important;\n  border: 2px solid #b5a48c !important;\n  border-radius: 6px !important;\n  color: #2c2520 !important;\n  font-family: 'Patrick Hand', cursive !important;\n  font-size: 15px !important;\n}\n\n.chat-input:focus {\n  border-color: var(--accent-cyan) !important;\n  box-shadow: 0 0 6px rgba(0, 102, 204, 0.15) !important;\n}\n\n/* Settings Hub Modal */\n#settingsModal > div {\n  background: #fcf8f2 !important;\n  border: 3px solid #8b7355 !important;\n  border-radius: 16px !important;\n  box-shadow: 0 15px 40px rgba(0,0,0,0.15) !important;\n}\n\n#settingsModal h2 {\n  font-family: 'Architects Daughter', cursive !important;\n  color: #5c4033 !important;\n}\n\n.settings-tab {\n  font-family: 'Architects Daughter', cursive !important;\n  color: #5c4033 !important;\n}\n\n.settings-tab:hover {\n  background: rgba(139, 92, 246, 0.05) !important;\n  color: var(--accent-cyan) !important;\n}\n\n.settings-tab.active {\n  background: #ebdcb9 !important;\n  color: var(--accent-blue) !important;\n  border-left: 4px solid var(--accent-blue) !important;\n  padding-left: 20px !important;\n}\n\n.settings-section h3 {\n  font-family: 'Architects Daughter', cursive !important;\n  color: #5c4033 !important;\n  border-bottom: 1px dashed #b5a48c !important;\n  padding-bottom: 6px !important;\n}\n\n.setting-title {\n  font-family: 'Architects Daughter', cursive !important;\n  font-weight: bold !important;\n  color: #5c4033 !important;\n}\n\n.setting-desc {\n  font-family: 'Patrick Hand', cursive !important;\n  font-size: 14px !important;\n  color: #8c8075 !important;\n}\n\n/* Custom Scrollbars for Notebook Aesthetic */\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n::-webkit-scrollbar-track {\n  background: #f6f0e5;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #c8b9a6;\n  border: 2px solid #f6f0e5;\n  border-radius: 5px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #a89986;\n}"
}