{
  "metadata": {
    "name": "Simplicity",
    "version": "1.0.0",
    "description": "A modern take on pastoral simplicity. Warm accents, soft herbal tones, and cozy cream typography that feels like a warm hug and a cup of tea.",
    "author": "Misterscan",
    "icon": "🍵",
    "commands": [
      "Apply Simplicity"
    ]
  },
  "css": "\n\n:root {\n  --bg-base: #1e1b18;\n  --bg-panel: #272320;\n  --accent-cyan: #df9f56;\n  --accent-blue: #93a285;\n  --accent-green: #b8c4a4;\n  --silver-light: #f7f3eb;\n  --silver-mid: #cfc4b6;\n  --silver-dark: #8c7e70;\n  --glass-bg: rgba(39, 35, 32, 0.85);\n  --glass-border: rgba(223, 159, 86, 0.15);\n  --glass-highlight: rgba(247, 243, 235, 0.05);\n}\n\n/* Custom Scrollbars - Soft wood & linen tones */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: var(--bg-base);\n}\n::-webkit-scrollbar-thumb {\n  background: #3e3730;\n  border-radius: 4px;\n  border: 2px solid var(--bg-base);\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--accent-cyan);\n}\n\n/* Global Body Override */\nbody {\n  background-color: var(--bg-base);\n  color: var(--silver-light);\n  font-family: 'Space Grotesk', sans-serif;\n  letter-spacing: 0.1px;\n}\n\n/* Header styling */\nheader {\n  background: rgba(30, 27, 24, 0.95) !important;\n  border-bottom: 1px solid var(--glass-border);\n  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);\n}\n\n.brand h1 {\n  font-weight: 500;\n  color: var(--silver-light);\n}\n\n.glow-text {\n  color: var(--accent-cyan) !important;\n  text-shadow: 0 0 12px rgba(223, 159, 86, 0.25);\n}\n\n/* Cozy Buttons */\n.btn {\n  background: #36302b;\n  border: 1px solid rgba(223, 159, 86, 0.25);\n  color: var(--silver-mid);\n  border-radius: 8px;\n  padding: 6px 16px;\n  font-weight: 500;\n  transition: all 0.2s ease-in-out;\n}\n\n.btn:hover {\n  background: var(--accent-cyan);\n  color: #1e1b18;\n  border-color: var(--accent-cyan);\n  box-shadow: 0 2px 8px rgba(223, 159, 86, 0.2);\n}\n\n.btn:active {\n  transform: translateY(1px);\n}\n\n/* Panels */\n.panel {\n  background: var(--glass-bg);\n  border-right: 1px solid var(--glass-border);\n}\n\n.panel-header {\n  background: rgba(30, 27, 24, 0.4) !important;\n  border-bottom: 1px solid var(--glass-border);\n  height: 38px;\n}\n\n.panel-title {\n  color: var(--accent-cyan);\n  font-weight: 600;\n  letter-spacing: 0.8px;\n}\n\n/* File Tree */\n#fileTree {\n  padding: 12px 0;\n}\n\n.file-item {\n  padding: 8px 18px;\n  border-radius: 4px;\n  margin: 2px 8px;\n  color: var(--silver-mid);\n  transition: all 0.2s ease;\n}\n\n.file-item:hover {\n  background: rgba(147, 162, 133, 0.1);\n  color: var(--silver-light);\n}\n\n.file-item.active {\n  background: rgba(223, 159, 86, 0.12);\n  border-left: 3px solid var(--accent-cyan);\n  color: var(--accent-cyan);\n  font-weight: 600;\n}\n\n/* Tab Bar & Tabs */\n.tab-bar {\n  background: rgba(24, 21, 19, 0.8) !important;\n  border-bottom: 1px solid var(--glass-border);\n}\n\n.tab {\n  background: rgba(39, 35, 32, 0.4);\n  border-right: 1px solid var(--glass-border);\n  color: var(--silver-mid);\n  transition: all 0.2s ease;\n  border-top: 2px solid transparent;\n}\n\n.tab:hover {\n  background: rgba(39, 35, 32, 0.7);\n  color: var(--silver-light);\n}\n\n.tab.active {\n  background: var(--bg-panel);\n  color: var(--silver-light);\n  border-bottom: none;\n  border-top: 2px solid var(--accent-cyan);\n}\n\n.tab-close {\n  transition: color 0.15s ease;\n}\n\n.tab-close:hover {\n  color: #d96a6a !important;\n}\n\n/* Terminal Panel */\n.terminal-container-wrapper {\n  background: #181513 !important;\n  border-top: 1px solid var(--glass-border);\n}\n\n#terminalContainer {\n  background: #181513 !important;\n}\n\n/* Co-Pilot Chat */\n.chat-messages {\n  background: rgba(30, 27, 24, 0.25) !important;\n}\n\n.chat-tabs {\n  background: rgba(24, 21, 19, 0.9) !important;\n  border-bottom: 1px solid var(--glass-border);\n}\n\n.chat-tab {\n  border-right: 1px solid var(--glass-border);\n  transition: all 0.2s ease;\n}\n\n.chat-tab.active {\n  background: rgba(223, 159, 86, 0.12) !important;\n  color: var(--accent-cyan) !important;\n  border-bottom: 2px solid var(--accent-cyan);\n}\n\n.message {\n  border-radius: 8px;\n  line-height: 1.6;\n  padding: 12px 16px;\n}\n\n.message.system {\n  background: rgba(147, 162, 133, 0.08) !important;\n  border: 1px solid rgba(147, 162, 133, 0.2) !important;\n  color: var(--silver-light);\n}\n\n.message.user {\n  background: rgba(223, 159, 86, 0.06) !important;\n  border: 1px solid rgba(223, 159, 86, 0.2) !important;\n  color: var(--silver-light);\n}\n\n.message code {\n  color: var(--accent-cyan) !important;\n  background: rgba(0, 0, 0, 0.2);\n  padding: 2px 6px;\n  border-radius: 4px;\n}\n\n.message pre {\n  background: #181513 !important;\n  border: 1px solid var(--glass-border) !important;\n  border-radius: 8px;\n}\n\n.code-actions-header {\n  background: rgba(30, 27, 24, 0.9) !important;\n  border-bottom: 1px solid var(--glass-border);\n}\n\n.code-action-btn {\n  border-color: var(--accent-blue) !important;\n  color: var(--accent-blue) !important;\n  border-radius: 4px;\n  padding: 3px 8px;\n  transition: all 0.15s ease;\n}\n\n.code-action-btn:hover {\n  background: var(--accent-blue) !important;\n  color: #1e1b18 !important;\n}\n\n/* Chat Input */\n.chat-input-area {\n  background: rgba(30, 27, 24, 0.6) !important;\n  border-top: 1px solid var(--glass-border);\n}\n\n.chat-input {\n  background: #181513 !important;\n  border: 1px solid rgba(223, 159, 86, 0.25) !important;\n  color: var(--silver-light) !important;\n  border-radius: 6px;\n  padding: 10px 14px;\n  transition: all 0.2s ease;\n}\n\n.chat-input:focus {\n  border-color: var(--accent-cyan) !important;\n  box-shadow: 0 0 10px rgba(223, 159, 86, 0.15) !important;\n}\n\n/* Settings Hub Modal */\n#settingsModal {\n  background: rgba(24, 21, 19, 0.85) !important;\n}\n\n#settingsModal > div {\n  background: var(--bg-panel) !important;\n  border: 1px solid rgba(223, 159, 86, 0.25) !important;\n  border-radius: 12px;\n  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6) !important;\n}\n\n.settings-tab {\n  transition: all 0.2s ease;\n}\n\n.settings-tab:hover {\n  background: rgba(223, 159, 86, 0.08) !important;\n  color: var(--silver-light) !important;\n}\n\n.settings-tab.active {\n  background: rgba(223, 159, 86, 0.12) !important;\n  color: var(--accent-cyan) !important;\n  border-left: 3px solid var(--accent-cyan) !important;\n  font-weight: 600;\n}\n\n.setting-item {\n  border-bottom: 1px solid rgba(223, 159, 86, 0.1) !important;\n}\n\n.settings-section h3 {\n  color: var(--accent-cyan) !important;\n  font-weight: 600;\n}\n\n/* Timeline/Local History Header */\n.panel-header[style*=\"background: rgba(139, 92, 246, 0.05);\"] {\n  background: rgba(223, 159, 86, 0.05) !important;\n}"
}