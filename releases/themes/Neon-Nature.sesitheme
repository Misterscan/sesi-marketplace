  },
  "css": "\n\n\n:root {\n  --bg-base: #050a08;\n  --bg-panel: #0a1410;\n  --accent-cyan: #00ffcc;\n  --accent-blue: #39ff14;\n  --accent-green: #00ff9f;\n  --silver-light: #e0f2f1;\n  --silver-mid: #80cbc4;\n  --silver-dark: #2d4f43;\n  --glass-bg: rgba(10, 20, 16, 0.85);\n  --glass-border: rgba(0, 255, 159, 0.2);\n  --glass-highlight: rgba(57, 255, 20, 0.1);\n}\n\nbody {\n  background-color: var(--bg-base);\n  background-image: \n    radial-gradient(circle at 50% 50%, rgba(0, 255, 159, 0.03) 0%, transparent 50%),\n    linear-gradient(to bottom, transparent, rgba(5, 10, 8, 0.8));\n  color: var(--silver-light);\n}\n\nheader {\n  background: rgba(5, 15, 10, 0.9);\n  border-bottom: 2px solid var(--accent-green);\n  box-shadow: 0 0 20px rgba(0, 255, 159, 0.15);\n}\n\n.brand h1 {\n  text-shadow: 0 0 10px rgba(0, 255, 204, 0.5);\n}\n\n.glow-text {\n  color: var(--accent-green);\n  text-shadow: 0 0 8px rgba(0, 255, 159, 0.4);\n}\n\n.btn {\n  background: rgba(10, 30, 20, 0.6);\n  border: 1px solid var(--accent-green);\n  color: var(--accent-green);\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  box-shadow: inset 0 0 5px rgba(0, 255, 159, 0.1);\n}\n\n.btn:hover {\n  background: var(--accent-green);\n  color: #050a08;\n  box-shadow: 0 0 15px rgba(0, 255, 159, 0.4);\n}\n\n.panel {\n  background: var(--glass-bg);\n  border-color: var(--glass-border);\n}\n\n.panel-header {\n  background: rgba(0, 255, 159, 0.05);\n  border-bottom: 1px solid var(--glass-border);\n}\n\n.panel-title {\n  color: var(--accent-green);\n  text-shadow: 0 0 5px rgba(0, 255, 159, 0.3);\n}\n\n.file-item {\n  color: var(--silver-mid);\n  border-left: 2px solid transparent;\n}\n\n.file-item:hover {\n  background: rgba(57, 255, 20, 0.08);\n  color: var(--accent-blue);\n}\n\n.file-item.active {\n  background: rgba(0, 255, 159, 0.12);\n  border-left: 3px solid var(--accent-green);\n  color: var(--accent-green);\n  text-shadow: 0 0 8px rgba(0, 255, 159, 0.3);\n}\n\n.tab-bar {\n  background: rgba(5, 10, 8, 0.5);\n}\n\n.tab {\n  background: rgba(0, 0, 0, 0.2);\n  border-right: 1px solid var(--glass-border);\n  color: var(--silver-mid);\n}\n\n.tab.active {\n  background: var(--bg-panel);\n  color: var(--accent-cyan);\n  border-bottom: 2px solid var(--accent-cyan);\n  box-shadow: inset 0 -5px 15px rgba(0, 255, 204, 0.05);\n}\n\n.terminal-container-wrapper {\n  background: #020504;\n  border-top: 2px solid var(--silver-dark);\n}\n\n#terminalContainer {\n  filter: sepia(1) hue-rotate(90deg) brightness(1.2);\n}\n\n.chat-messages {\n  background: linear-gradient(180deg, rgba(10, 20, 16, 0.4) 0%, rgba(5, 10, 8, 0.6) 100%);\n}\n\n.message.system {\n  background: rgba(0, 255, 159, 0.05);\n  border: 1px solid rgba(0, 255, 159, 0.2);\n  color: var(--silver-light);\n}\n\n.message.user {\n  background: rgba(0, 255, 204, 0.05);\n  border: 1px solid rgba(0, 255, 204, 0.2);\n  color: var(--accent-cyan);\n}\n\n.chat-input {\n  background: #020504;\n  border: 1px solid var(--silver-dark);\n  color: var(--accent-green);\n}\n\n.chat-input:focus {\n  border-color: var(--accent-green);\n  box-shadow: 0 0 10px rgba(0, 255, 159, 0.2);\n}\n\n.code-action-btn {\n  border: 1px solid var(--accent-green);\n  color: var(--accent-green);\n}\n\n.code-action-btn:hover {\n  background: var(--accent-green);\n  color: #050a08;\n}\n\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--bg-base);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--silver-dark);\n  border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--accent-green);\n}\n\n/* Monaco Editor Overrides */\n.monaco-editor, .monaco-editor .margin {\n  background-color: #050a08 !important;\n}\n\n.monaco-editor .line-numbers {\n  color: var(--silver-dark) !important;\n}\n\n.monaco-editor .line-numbers.active-line-number {\n  color: var(--accent-green) !important;\n}\n\n.settings-tab.active {\n  background: rgba(0, 255, 159, 0.1) !important;\n  color: var(--accent-green) !important;\n  border-left-color: var(--accent-green) !important;\n}\n\n.settings-section h3 {\n  color: var(--accent-green);\n  text-shadow: 0 0 5px rgba(0, 255, 159, 0.2);\n}\n\n#settingsModal > div {\n  border: 1px solid var(--accent-green) !important;\n  box-shadow: 0 0 40px rgba(0, 255, 159, 0.1) !important;\n}"
}